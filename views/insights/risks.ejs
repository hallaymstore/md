<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line intelligence-hero"><div><span class="eyebrow">MAGISTRATURA TAHLILI</span><h1>Erta ogohlantirish markazi</h1><p>Oddiy “qizil/sariq/yashil” emas — har bir magistrantning xavf ko‘rsatkichi va sababi avtomatik ko‘rsatiladi.</p></div><div class="hero-actions"><a class="secondary" href="/insights/supervisors">Rahbar yuklamasi</a><a class="primary" href="/tasks">Chora-tadbir topshirig‘i →</a></div></section>
<section class="kpi-grid"><article class="kpi danger-kpi"><span>YUQORI XAVF</span><strong><%= counts.red %></strong><small>darhol nazorat</small></article><article class="kpi"><span>NAZORATDA</span><strong><%= counts.yellow %></strong></article><article class="kpi"><span>BARQAROR</span><strong><%= counts.green %></strong></article><article class="kpi"><span>JAMI</span><strong><%= cards.length %></strong></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">NAZORAT RO‘YXATI</span><h2>Sabablar bilan saralangan magistrantlar</h2></div><input class="compact-search" id="riskSearch" placeholder="F.I.Sh. / guruh qidirish"></div>
<div class="risk-card-list" id="riskList"><% cards.forEach(card=>{ %><article class="risk-card" data-search="<%= (card.student.fullName+' '+(card.student.group||'')+' '+(card.student.department||'')).toLowerCase() %>"><div class="risk-score <%= card.severity %>"><strong><%= card.score %></strong><span>/100</span></div><div class="risk-person"><b><%= card.student.fullName %></b><span><%= card.student.group||'—' %> · <%= card.student.department||'—' %></span><small>Rahbar: <%= card.student.supervisor?.fullName||'biriktirilmagan' %></small></div><div class="risk-reasons"><% card.reasons.slice(0,5).forEach(r=>{ %><span class="risk-reason"><b>+<%= r.points %></b><%= r.label %><small><%= r.value %></small></span><% }) %><% if(!card.reasons.length){ %><span class="risk-reason good">Barqaror holat</span><% } %></div><div class="risk-actions"><span class="status <%= card.severity %>"><%= card.severity==='red'?'Yuqori':card.severity==='yellow'?'Nazorat':'Barqaror' %></span><a class="table-link" href="/students/<%= card.student._id %>">Profil →</a></div></article><% }) %></div></section>
<script>document.getElementById('riskSearch')?.addEventListener('input',e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('#riskList .risk-card').forEach(x=>x.hidden=!x.dataset.search.includes(q));});</script>
</main></div><%- include('../partials/foot') %>
