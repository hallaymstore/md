<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line"><div><span class="eyebrow">O‘ZGARISHLAR DINAMIKASI</span><h1>Natija qaysi tomonga ketmoqda?</h1><p>Bugungi raqamdan tashqari, ko‘rsatkichlarning vaqt bo‘yicha yaxshilanishi yoki pasayishi ham kuzatiladi.</p></div></section>
<section class="kpi-grid dense"><article class="kpi"><span>DAVOMAT O‘ZGARISHI</span><strong class="<%= delta.attendance<0?'text-danger':'text-good' %>"><%= delta.attendance>0?'+':'' %><%= delta.attendance %></strong><small>foiz punkt</small></article><article class="kpi"><span>REJA O‘ZGARISHI</span><strong><%= delta.plan>0?'+':'' %><%= delta.plan %></strong><small>foiz punkt</small></article><article class="kpi"><span>DISSERTATSIYA</span><strong><%= delta.dissertation>0?'+':'' %><%= delta.dissertation %></strong><small>foiz punkt</small></article><article class="kpi"><span>BITIRUV TAYYORLIGI</span><strong><%= delta.readiness>0?'+':'' %><%= delta.readiness %></strong><small>foiz punkt</small></article><article class="kpi"><span>MUAMMOLI HOLAT</span><strong><%= delta.red>0?'+':'' %><%= delta.red %></strong><small>o‘zgarish</small></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">SO‘NGGI DAVR</span><h2>Ko‘rsatkichlar tarixi</h2><p>Tarix har kuni avtomatik yig‘iladi. Birinchi kunlarda grafik qisqa bo‘lishi tabiiy.</p></div><span class="badge"><%= days %> kun</span></div><div class="trend-table"><div class="trend-head"><span>Sana</span><span>Davomat</span><span>Reja</span><span>Dissertatsiya</span><span>Bitiruv</span><span>Muammoli</span></div><% trend.forEach(row=>{ %><div class="trend-row"><b><%= new Date(row.day+'T00:00:00').toLocaleDateString('uz-UZ',{day:'2-digit',month:'short'}) %></b><div><i style="width:<%= row.attendance %>%"></i><span><%= row.attendance %>%</span></div><div><i style="width:<%= row.plan %>%"></i><span><%= row.plan %>%</span></div><div><i style="width:<%= row.dissertation %>%"></i><span><%= row.dissertation %>%</span></div><div><i style="width:<%= row.readiness %>%"></i><span><%= row.readiness %>%</span></div><strong><%= row.red %></strong></div><% }) %><% if(!trend.length){ %><div class="empty">Tarixiy ma’lumot yig‘ilishi endi boshlanadi.</div><% } %></div></section>
</main></div><%- include('../partials/foot') %>
