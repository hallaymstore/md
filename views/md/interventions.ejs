<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line"><div><span class="eyebrow">MUAMMO → CHORA → NATIJA</span><h1>Muammo va chora markazi</h1><p>Muammoni aniqlashning o‘zi yetarli emas: sabab, mas’ul, chora, muddat va yakuniy natija bir zanjirda yuritiladi.</p></div></section>
<% if(canEdit){ %><section class="panel"><div class="panel-head"><div><span class="eyebrow">YANGI NAZORAT</span><h2>Muammo uchun chora rejasini yarating</h2></div></div><form method="post" action="/md/interventions" class="form-grid" data-offline-queue="1"><label class="wide">Muammo nomi<input name="title" required placeholder="Masalan: Dissertatsiya jadvalidan ortda qolmoqda"></label><label>Magistrant<select name="student"><option value="">Umumiy</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.fullName %> — <%= s.group||'—' %></option><% }) %></select></label><label>Mas’ul<select name="assignedTo"><option value="">Tanlanmagan</option><% assignees.forEach(u=>{ %><option value="<%= u._id %>"><%= u.fullName %></option><% }) %></select></label><label>Yo‘nalish<select name="type"><option value="attendance">Davomat</option><option value="plan">Individual reja</option><option value="dissertation">Dissertatsiya</option><option value="document">Hujjat</option><option value="academic">O‘zlashtirish</option><option value="publication">Maqola</option><option value="other">Boshqa</option></select></label><label>Ustuvorlik<select name="priority"><option value="medium">O‘rta</option><option value="high">Yuqori</option><option value="critical">Juda muhim</option><option value="low">Past</option></select></label><label>Muddat<input type="date" name="dueDate"></label><label>Qayta tekshiruv<input type="date" name="followUpDate"></label><label class="wide">Muammo sababi<textarea name="issueReason" placeholder="Muammo nimadan kelib chiqdi?"></textarea></label><label class="wide">Chora rejasi<textarea name="actionPlan" placeholder="Kim nima qiladi?"></textarea></label><label class="wide">Kutilayotgan natija<textarea name="expectedResult" placeholder="Natijada nima o‘zgarishi kerak?"></textarea></label><div class="wide form-actions"><button class="primary">Chora rejasini yaratish</button></div></form></section><% } %>
<section class="intervention-grid"><% tasks.forEach(t=>{ %><article class="panel intervention-card <%= t.status==='resolved'?'is-resolved':'' %>"><header><div><span class="priority <%= t.priority %>"><%= t.priority==='critical'?'Juda muhim':t.priority==='high'?'Yuqori':t.priority==='low'?'Past':'O‘rta' %></span><h2><%= t.title %></h2><p><%= t.student?.fullName||'Umumiy masala' %> <% if(t.student?.group){ %>· <%= t.student.group %><% } %></p></div><span class="status <%= t.escalation.level>=3?'red':t.escalation.level>=2?'yellow':'green' %>"><%= t.escalation.label %></span></header><div class="intervention-flow"><div><span>SABAB</span><b><%= t.issueReason||t.description||'Ko‘rsatilmagan' %></b></div><div><span>MAS’UL</span><b><%= t.assignedTo?.fullName||'Biriktirilmagan' %></b></div><div><span>CHORA</span><b><%= t.actionPlan||'Belgilanmagan' %></b></div><div><span>MUDDAT</span><b><%= t.dueDate?new Date(t.dueDate).toLocaleDateString('uz-UZ'):'Belgilanmagan' %></b></div><div><span>NATIJA</span><b><%= t.outcome||t.resolution||'Kutilmoqda' %></b></div></div><form method="post" action="/md/interventions/<%= t._id %>" class="compact-action-form" data-offline-queue="1"><select name="status"><option value="new" <%= t.status==='new'?'selected':'' %>>Yangi</option><option value="in_progress" <%= t.status==='in_progress'?'selected':'' %>>Jarayonda</option><option value="resolved" <%= t.status==='resolved'?'selected':'' %>>Yopildi</option></select><input name="outcome" value="<%= t.outcome||'' %>" placeholder="Natija / yakuniy izoh"><button class="tiny-btn">Yangilash</button></form></article><% }) %><% if(!tasks.length){ %><article class="panel empty">Hozircha muammo va chora yozuvi yo‘q.</article><% } %></section>
</main></div><%- include('../partials/foot') %>
