<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line"><div><span class="eyebrow">BITIRUV CHECKLISTI</span><h1>Bitiruvga tayyorlik</h1><p>Bitiruv uchun zarur asosiy bandlar avtomatik ko‘rsatkichlar va mas’ul tasdig‘i bilan bir joyda.</p></div></section>
<% if(currentUser.role!=='student'){ %><section class="panel milestone-selector"><form method="get"><label>Magistrant<select name="student" onchange="this.form.submit()"><% students.forEach(s=>{ %><option value="<%= s._id %>" <%= selected&&String(selected._id)===String(s._id)?'selected':'' %>><%= s.fullName %> — <%= s.group||'—' %></option><% }) %></select></label></form></section><% } %>
<% if(selected){ %><section class="graduation-head panel"><div><span class="eyebrow">MAGISTRANT</span><h2><%= selected.fullName %></h2><p><%= selected.group||'—' %> · <%= selected.specialty||'—' %></p></div><div class="graduation-score"><strong><%= readiness %></strong><small>%</small><span>tayyor</span></div></section>
<section class="graduation-check-grid"><% rows.forEach(row=>{ %><article class="panel graduation-check <%= row.done?'done':'pending' %>"><header><span class="check-state"><%= row.done?'✓':'!' %></span><div><h2><%= row.label %></h2><p><%= row.status==='done'?'Mas’ul tomonidan bajarildi deb belgilangan':row.status==='not_required'?'Talab etilmaydi':row.automatic?'Ma’lumotlar asosida bajarilgan':'E’tibor talab qiladi' %></p></div></header><% if(row.note){ %><p class="check-note"><%= row.note %></p><% } %><% if(canEdit){ %><form method="post" action="/md/graduation/<%= selected._id %>/<%= row.key %>" class="graduation-form" data-offline-queue="1"><select name="status"><option value="auto" <%= row.status==='auto'?'selected':'' %>>Avtomatik baholash</option><option value="done" <%= row.status==='done'?'selected':'' %>>Bajarildi</option><option value="pending" <%= row.status==='pending'?'selected':'' %>>Kutilmoqda</option><option value="not_required" <%= row.status==='not_required'?'selected':'' %>>Talab etilmaydi</option></select><input name="note" value="<%= row.note %>" placeholder="Izoh"><button class="tiny-btn">Saqlash</button></form><% } %></article><% }) %></section><% }else{ %><section class="panel empty">Magistrant topilmadi.</section><% } %>
</main></div><%- include('../partials/foot') %>
