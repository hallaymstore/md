<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line"><div><span class="eyebrow">MUDDATLAR MARKAZI</span><h1>Yaqinlashayotgan va kechikkan ishlar</h1><p>Topshiriq, dissertatsiya bosqichi, ilmiy ariza va hujjat muddatlari bitta sahifada.</p></div></section>
<section class="kpi-grid dense"><article class="kpi"><span>KECHIKKAN</span><strong><%= counts.overdue %></strong><small>muddat o‘tgan</small></article><article class="kpi"><span>7 KUN ICHIDA</span><strong><%= counts.week %></strong><small>yaqin vazifa</small></article><article class="kpi"><span>30 KUN ICHIDA</span><strong><%= counts.month %></strong><small>rejalashtirilgan</small></article><article class="kpi"><span>KUCHAYTIRILGAN NAZORAT</span><strong><%= counts.escalated %></strong><small>kechikishi jiddiy</small></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">VAQT JADVALI</span><h2>Barcha muddatlar</h2></div><span class="badge"><%= items.length %> ta</span></div><div class="table-wrap"><table><thead><tr><th>Tur</th><th>Magistrant</th><th>Ish</th><th>Muddat</th><th>Nazorat darajasi</th><th></th></tr></thead><tbody>
<% items.forEach(item=>{ const late=new Date(item.dueDate)<new Date(); %><tr><td><span class="chip"><%= item.kind %></span></td><td><b><%= item.student?.fullName||'Umumiy' %></b><small><%= item.student?.group||'' %></small></td><td><%= item.title %></td><td><span class="status <%= late?'red':'green' %>"><%= new Date(item.dueDate).toLocaleDateString('uz-UZ') %></span></td><td><span class="priority <%= item.level>=3?'critical':item.level>=2?'high':'medium' %>"><%= item.label %></span></td><td><a class="table-link" href="<%= item.url %>">Ochish →</a></td></tr><% }) %>
<% if(!items.length){ %><tr><td colspan="6" class="empty">Hozircha belgilangan muddatlar yo‘q.</td></tr><% } %></tbody></table></div></section>
</main></div><%- include('../partials/foot') %>
