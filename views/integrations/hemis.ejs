<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line intelligence-hero"><div><span class="eyebrow">HEMIS MA’LUMOTLARI</span><h1>HEMIS ma’lumotlarini yangilash</h1><p>HEMISdan olingan talabalar ro‘yxatini shu yerda tekshirib yangilang. Mavjud dissertatsiya, ilmiy portfel, arizalar tarixi va nazorat ma’lumotlari saqlanib qoladi.</p></div></section>
<section class="profile-visibility-note"><span>i</span><div><b>MD HEMISni almashtirmaydi</b><p>HEMISdan olingan rasmiy ro‘yxat va akademik ma’lumotlar MD ichida dissertatsiya, ilmiy portfel, muddat, chora va boshqaruv nazorati bilan boyitiladi.</p></div></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">1. JADVALNI YUKLASH</span><h2>Avval tekshiring, keyin qabul qiling</h2></div></div><form method="post" action="/integrations/hemis/upload" enctype="multipart/form-data" class="form-grid"><label class="wide">HEMISdan olingan jadval<input type="file" name="csv" accept=".csv,text/csv" required></label><div class="wide hemis-help"><b>Tavsiya etilgan ustunlar</b><code>F.I.Sh., Talaba ID, Fakultet, Kafedra, Mutaxassislik, Guruh, Kurs, Davomat, O‘zlashtirish</code><small>Jadvaldagi ustunlar tizim tomonidan avtomatik aniqlanadi.</small></div><div class="wide form-actions"><button class="secondary" name="mode" value="preview">Ma’lumotlarni tekshirish</button><button class="primary" name="mode" value="import">Ma’lumotlarni qabul qilish</button></div></form></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">MAVJUD MA’LUMOTLAR</span><h2>Yangilashda saqlanadigan ma’lumotlar</h2></div></div><div class="feature-checks"><span>✓ Ilmiy rahbar biriktiruvi</span><span>✓ Dissertatsiya mavzusi va 12 bosqich</span><span>✓ Ilmiy portfolio va tasdiqlangan ishlar</span><span>✓ Arizalarni tasdiqlash tarixi</span><span>✓ Topshiriqlar va ko‘rilgan choralar</span><span>✓ Ilmiy profil va qiziqishlar</span></div></article></section>
<% if(preview){ %><section class="panel preview-panel"><div class="panel-head"><div><span class="eyebrow">TEKSHIRUV NATIJASI</span><h2><%= preview.filename %></h2><p><%= preview.rows.length %> qator o‘qildi · <%= preview.errors.length %> ogohlantirish</p></div></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>F.I.Sh.</th><th>Fakultet</th><th>Kafedra</th><th>Mutaxassislik</th><th>Guruh</th><th>Kurs</th><th>Davomat</th></tr></thead><tbody><% preview.rows.slice(0,20).forEach(r=>{ %><tr><td><%= r.studentId||'—' %></td><td><b><%= r.fullName %></b></td><td><%= r.faculty||'—' %></td><td><%= r.department||'—' %></td><td><%= r.specialty||'—' %></td><td><%= r.group||'—' %></td><td><%= r.course||'—' %></td><td><%= r.attendance??'—' %></td></tr><% }) %></tbody></table></div><% if(preview.errors.length){ %><div class="import-errors"><% preview.errors.slice(0,12).forEach(e=>{ %><span>⚠ <%= e %></span><% }) %></div><% } %></section><% } %>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">YANGILASH TARIXI</span><h2>So‘nggi ma’lumot yangilashlar</h2></div></div><div class="table-wrap"><table><thead><tr><th>Vaqt</th><th>Fayl</th><th>Kim</th><th>Qator</th><th>Yangi</th><th>Yangilandi</th><th>O‘tkazib yuborildi</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= new Date(l.createdAt).toLocaleString('uz-UZ') %></td><td><b><%= l.filename||'—' %></b></td><td><%= l.actor?.fullName||'—' %></td><td><%= l.totalRows %></td><td><%= l.created %></td><td><%= l.updated %></td><td><%= l.skipped %></td></tr><% }) %><% if(!logs.length){ %><tr><td colspan="7">Yangilash tarixi hali yo‘q.</td></tr><% } %></tbody></table></div></section>
</main></div><%- include('../partials/foot') %>
