<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="hero-line role-hero role-hero-system"><div><span class="eyebrow"><%= isSuperadmin?'UMUMIY BOSHQARUV':'TIZIM NAZORATI' %></span><h1><%= isSuperadmin?'Ma’lumotlar boshqaruvi':'Tizim boshqaruv markazi' %></h1><p><%= isSuperadmin?'Statistika, umumiy qidiruv, ma’lumotlar sifati, faoliyat tarixi va boshqaruv amallari bir markazda.':'Ma’lumotlar sifati, tizim holati va foydalanuvchi vakolatlari shu yerda boshqariladi.' %></p></div><div class="hero-actions"><a class="secondary" href="/audit">Faoliyat tarixi</a><a class="primary" href="/students/quick">⚡ Tezkor talaba kiritish</a></div></section>
<section class="kpi-grid wide-kpi"><article class="kpi"><span>FOYDALANUVCHILAR</span><strong><%= stats.users %></strong><small>faol: <b><%= stats.activeUsers %></b></small></article><article class="kpi"><span>MAGISTRANTLAR</span><strong><%= stats.students %></strong><small>muammoli: <b><%= stats.redStudents %></b></small></article><article class="kpi"><span>ILMIY ARIZALAR</span><strong><%= stats.submissions %></strong><small>jarayonda: <b><%= stats.pendingSubmissions %></b></small></article><article class="kpi"><span>FAYLLAR</span><strong><%= stats.uploads %></strong><small>material va hujjat</small></article><article class="kpi"><span>TOPSHIRIQLAR</span><strong><%= stats.tasks %></strong><small>ochiq: <b><%= stats.openTasks %></b></small></article><article class="kpi"><span>ILMIY FAOLIYAT</span><strong><%= stats.science %></strong><small>yozuvlar</small></article><article class="kpi"><span>BUGUNGI FAOLIYAT</span><strong><%= stats.auditToday %></strong><small>harakat</small></article></section>
<section class="panel control-search"><form method="get" action="/control"><div><span class="eyebrow">UMUMIY QIDIRUV</span><h2>Barcha ma’lumotlardan qidirish</h2></div><input name="q" value="<%= q %>" placeholder="Talaba, login, guruh, fakultet, topshiriq, fayl..."><button class="primary">Qidirish</button></form><% if(q){ %><div class="search-results"><% results.forEach(x=>{ %><a href="<%= x.href %>"><span class="chip"><%= x.entity %></span><b><%= x.title %></b><small><%= x.meta %></small></a><% }) %><% if(!results.length){ %><div class="empty-state">Natija topilmadi.</div><% } %></div><% } %></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">MA’LUMOTLAR SIFATI</span><h2>To‘ldirilishi kerak bo‘lgan joylar</h2></div></div><div class="quality-grid"><a href="/students"><span>Rahbarsiz magistrant</span><b><%= quality.noSupervisor %></b></a><a href="/students"><span>Telefon kiritilmagan</span><b><%= quality.noPhone %></b></a><a href="/students"><span>E-mail kiritilmagan</span><b><%= quality.noEmail %></b></a><a href="/students"><span>Profil &lt; 50%</span><b><%= quality.lowProfile %></b></a><a href="/students"><span>Dissertatsiya mavzusi yo‘q</span><b><%= quality.noDissertation %></b></a><a href="/documents"><span>Yetishmayotgan hujjat</span><b><%= quality.missingDocs %></b></a><a href="/submissions"><span>Rahbarsiz qoralama ariza</span><b><%= quality.submissionNoSupervisor %></b></a></div></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">MODULLAR</span><h2>Baza tarkibi</h2></div></div><div class="overview-grid"><div><span>Ilmiy ariza</span><b><%= stats.submissions %></b></div><div><span>Seminar</span><b><%= stats.seminars %></b></div><div><span>Hujjat</span><b><%= stats.documents %></b></div><div><span>Monitoring</span><b><%= stats.monitoring %></b></div><div><span>Akademik yo‘nalish</span><b><%= stats.structures %></b></div><div><span>Akademik birlik</span><b><%= stats.academicUnits||0 %></b></div></div><div class="control-links"><a href="/submissions">Ilmiy arizalar</a><a href="/structure">Akademik nomlar</a><a href="/users">Hisoblar</a><a href="/analytics">Analitika</a><a href="/uploads">Fayllar</a></div></article></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">SO‘NGGI TALABA O‘ZGARISHLARI</span><h2>Profil va monitoring</h2></div></div><div class="compact-list"><% recentStudents.forEach(s=>{ %><a href="/students/<%= s._id %>"><div><b><%= s.fullName %></b><span><%= s.faculty||'—' %> · <%= s.department||'—' %> · <%= s.group||'—' %></span></div><em class="status <%= s.status %>"><%= s.profileCompleteness||0 %>% profil</em></a><% }) %></div></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">SO‘NGGI FAOLIYAT</span><h2>Kim nima o‘zgartirdi?</h2></div><a href="/audit">Barchasi →</a></div><div class="compact-list"><% recentAudit.slice(0,12).forEach(a=>{ %><div class="audit-mini"><div><b><%= a.actor?.fullName||'Tizim' %></b><span><%= a.action %> · <%= a.entity||'—' %></span></div><time><%= new Date(a.createdAt).toLocaleString('uz-UZ') %></time></div><% }) %></div></article></section>
<% if(isSuperadmin){ %><section class="privacy-note"><b>⚠ Ehtiyotkorlik talab qiladigan amallar</b><span>Bosh administrator ma’lumotlarni tahrirlashi yoki o‘chirishi mumkin. Magistrant o‘chirilsa, unga bog‘langan tegishli ma’lumotlar ham o‘chiriladi. Amalni bajarishdan oldin ma’lumotlarni tekshiring.</span></section><% } %>
</main></div><%- include('../partials/foot') %>
