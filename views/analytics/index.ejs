<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line"><div><span class="eyebrow">KENGAYTIRILGAN TAHLIL</span><h1>Kengaytirilgan analitika</h1><p>Fakultet, kafedra, mutaxassislik, kurs va asosiy monitoring indikatorlari bo‘yicha kesim.</p></div><div class="hero-actions"><a class="primary" href="/analytics/export.csv">Jadvalni yuklab olish</a></div></section>
<section class="kpi-grid dense"><article class="kpi"><span>JAMI</span><strong><%= kpis.total %></strong></article><article class="kpi"><span>DAVOMAT</span><strong><%= kpis.attendance %>%</strong></article><article class="kpi"><span>REJA</span><strong><%= kpis.plan %>%</strong></article><article class="kpi"><span>DISSERTATSIYA</span><strong><%= kpis.dissertation %>%</strong></article><article class="kpi"><span>ILMIY FAOLLIK</span><strong><%= kpis.science %>%</strong></article><article class="kpi"><span>O‘ZLASHTIRISH</span><strong><%= kpis.academic %>%</strong></article><article class="kpi"><span>HUJJATLAR</span><strong><%= kpis.documents %>%</strong></article><article class="kpi"><span>BITIRUV TAYYORLIGI</span><strong><%= kpis.readiness %>%</strong></article><article class="kpi"><span>AKAD. QARZ</span><strong><%= kpis.academicDebt %></strong></article><article class="kpi"><span>MUAMMOLI</span><strong><%= kpis.problemStudents %></strong></article><article class="kpi"><span>MAQOLA</span><strong><%= kpis.publications %></strong></article><article class="kpi"><span>KONFERENSIYA</span><strong><%= kpis.conferences %></strong></article></section>
<section class="analytics-summary-strip">
<div class="analytics-ok"><span>BARQAROR HOLAT</span><b><%= status.green %></b><small><%= percentages.green %>% magistrant</small></div>
<div class="analytics-warn"><span>NAZORATDA</span><b><%= status.yellow %></b><small><%= percentages.yellow %>% magistrant</small></div>
<div class="analytics-danger"><span>MUAMMOLI</span><b><%= status.red %></b><small><%= percentages.red %>% magistrant</small></div>
<div class="analytics-danger"><span>KECHIKKAN TOPSHIRIQ</span><b><%= overdueTasks.length %></b><small>ochiq topshiriq: <%= openTasks.length %></small></div>
</section>
<section class="grid-3">
<article class="panel"><div class="panel-head"><div><span class="eyebrow">DAVOMAT SEGMENTI</span><h2>Nazorat taqsimoti</h2></div></div><div class="bucket-grid three"><div><b><%= attendanceBuckets.good %></b><span>90–100%</span></div><div><b><%= attendanceBuckets.watch %></b><span>75–89%</span></div><div class="risk"><b><%= attendanceBuckets.problem %></b><span>&lt;75%</span></div></div></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">HUJJAT INTIZOMI</span><h2>Komplektlik holati</h2></div></div><div class="bucket-grid three"><div><b><%= docStats.present %></b><span>Mavjud</span></div><div><b><%= docStats.update %></b><span>Yangilash</span></div><div class="risk"><b><%= docStats.missing %></b><span>Mavjud emas</span></div></div></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">SEMINAR INTIZOMI</span><h2>Ijro ko‘rsatkichlari</h2></div></div><div class="overview-grid"><div><span>O‘tkazildi</span><b><%= seminarStats.held %></b></div><div><span>Rejada</span><b><%= seminarStats.planned %></b></div><div><span>Bekor</span><b><%= seminarStats.cancelled %></b></div><div><span>Bayonnoma</span><b><%= seminarStats.minutes %></b></div><div><span>Material</span><b><%= seminarStats.materials %></b></div><div><span>Jami</span><b><%= seminars.length %></b></div></div></article>
</section>
<section class="grid-2">
<article class="panel"><div class="panel-head"><div><span class="eyebrow">ILMIY EKOTIZIM</span><h2>Faoliyatlar tarkibi</h2></div></div><div class="overview-grid"><div><span>Maqola</span><b><%= scienceStats.publications %></b></div><div><span>Konferensiya</span><b><%= scienceStats.conferences %></b></div><div><span>Tadqiqot</span><b><%= scienceStats.research %></b></div><div><span>Ilmiy seminar</span><b><%= scienceStats.seminars %></b></div><div><span>Tasdiqlangan</span><b><%= scienceStats.accepted %></b></div><div><span>Jami yozuv</span><b><%= science.length %></b></div></div></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">TIZIMDAGI FAOLIYAT</span><h2>Tizim faolligi</h2></div></div><div class="overview-grid"><div><span>Monitoring yozuvi</span><b><%= kpis.monitorRecords %></b></div><div><span>Material / fayl</span><b><%= kpis.uploads %></b></div><div><span>Ochiq topshiriq</span><b><%= kpis.openTasks %></b></div><div><span>Kechikkan</span><b><%= kpis.overdueTasks %></b></div><div><span>Akad. qarz</span><b><%= kpis.academicDebt %></b></div><div><span>Yo‘q hujjat</span><b><%= kpis.missingDocs %></b></div></div></article>
</section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">FAKULTET</span><h2>Fakultetlar taqqoslanishi</h2></div></div><div class="table-wrap"><table><thead><tr><th>Nomi</th><th>Soni</th><th>Davomat</th><th>Reja</th><th>Diss.</th><th>Ilmiy</th><th>Hujjat</th><th>Muammo</th></tr></thead><tbody><% facultyStats.forEach(x=>{ %><tr><td><b><%= x.name %></b></td><td><%= x.total %></td><td><%= x.attendance %>%</td><td><%= x.plan %>%</td><td><%= x.dissertation %>%</td><td><%= x.science %>%</td><td><%= x.documents %>%</td><td><span class="status <%= x.red?'red':'green' %>"><%= x.red %></span></td></tr><% }) %></tbody></table></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">KAFEDRA</span><h2>Kafedralar taqqoslanishi</h2></div></div><div class="table-wrap"><table><thead><tr><th>Nomi</th><th>Soni</th><th>Davomat</th><th>Diss.</th><th>Bitiruv</th><th>Muammo</th></tr></thead><tbody><% departmentStats.forEach(x=>{ %><tr><td><b><%= x.name %></b></td><td><%= x.total %></td><td><%= x.attendance %>%</td><td><%= x.dissertation %>%</td><td><%= x.readiness %>%</td><td><%= x.red %></td></tr><% }) %></tbody></table></div></article></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">MUTAXASSISLIK</span><h2>Yo‘nalishlar kesimi</h2></div></div><div class="metric-list"><% specialtyStats.forEach(x=>{ %><div class="metric-row"><div><b><%= x.name %></b><span><%= x.total %> magistrant</span></div><div class="metric-bars"><em><i style="width:<%= x.readiness %>%"></i></em><strong><%= x.readiness %>%</strong></div></div><% }) %></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">DISSERTATSIYA</span><h2>Bajarilish segmentlari</h2></div></div><div class="bucket-grid"><div><b><%= dissertationBuckets.complete %></b><span>100%</span></div><div><b><%= dissertationBuckets.high %></b><span>75–99%</span></div><div><b><%= dissertationBuckets.medium %></b><span>50–74%</span></div><div class="risk"><b><%= dissertationBuckets.low %></b><span>&lt;50%</span></div></div></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">ILMIY RAHBARLAR</span><h2>Rahbarlar yuklamasi va natijasi</h2></div></div><div class="table-wrap"><table><thead><tr><th>Rahbar</th><th>Magistrant</th><th>Davomat</th><th>Reja</th><th>Dissertatsiya</th><th>Muammoli</th></tr></thead><tbody><% supervisorStats.forEach(x=>{ %><tr><td><b><%= x.name %></b></td><td><%= x.total %></td><td><%= x.attendance %>%</td><td><%= x.plan %>%</td><td><%= x.dissertation %>%</td><td><%= x.red %></td></tr><% }) %></tbody></table></div></section>
<section class="panel danger-panel"><div class="panel-head"><div><span class="eyebrow">NAZORAT RO‘YXATI</span><h2>Eng ko‘p nazorat talab qiladigan magistrantlar</h2><p>Davomat, individual reja, dissertatsiya, hujjatlar va akademik qarz bo‘yicha avtomatik saralangan.</p></div><span class="badge red"><%= problems.length %> ta</span></div><div class="table-wrap"><table><thead><tr><th>Magistrant</th><th>Fakultet</th><th>Kafedra</th><th>Davomat</th><th>Reja</th><th>Dissertatsiya</th><th>Hujjat</th><th>Qarz</th><th></th></tr></thead><tbody><% problems.slice(0,20).forEach(s=>{ %><tr><td><b><%= s.fullName %></b><small><%= s.group||'—' %></small></td><td><%= s.faculty||'—' %></td><td><%= s.department||'—' %></td><td><%= s.attendance %>%</td><td><%= s.individualPlan %>%</td><td><%= s.dissertationProgress %>%</td><td><%= s.documentsCompleteness %>%</td><td><%= s.academicDebtCount||0 %></td><td><a class="table-link" href="/students/<%= s._id %>">Ochish →</a></td></tr><% }) %></tbody></table></div></section>
</main></div><%- include('../partials/foot') %>
