<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="panel profile-head"><div class="avatar" style="width:52px;height:52px;border-radius:15px;font-size:18px"><%= student.fullName.charAt(0) %></div><div class="profile-id"><span class="eyebrow"><%= student.studentId||'ID yo‘q' %> • <%= student.group||'—' %></span><h1><%= student.fullName %></h1><p class="muted"><%= student.specialty||'—' %> · <%= student.faculty||'—' %></p></div><div class="mini-stats"><span class="status <%= student.status %>"><%= student.status %></span><span class="profile-mini"><%= student.profileCompleteness||0 %>% profil</span><% if(profileAccess.self){ %><a class="tiny-btn" href="/students/me/profile">Profilimni to‘ldirish</a><% } else if(['superadmin','tech','magistracy','dean','department'].includes(currentUser.role)){ %><a class="tiny-btn" href="/students/<%= student._id %>/edit">Akademik profil</a><% if(['superadmin','tech'].includes(currentUser.role)){ %><form method="post" action="/control/student/<%= student._id %>/delete" onsubmit="return confirm('Magistrant va bog‘langan monitoring/hujjat ma’lumotlarini butunlay o‘chirishni tasdiqlaysizmi?')"><button class="tiny-btn danger-btn">O‘chirish</button></form><% } %><% } %></div></section>
<section class="kpi-grid"><article class="kpi"><span>DAVOMAT</span><strong><%= student.attendance %>%</strong></article><article class="kpi"><span>O‘ZLASHTIRISH</span><strong><%= student.academicScore %>%</strong></article><article class="kpi"><span>INDIVIDUAL REJA</span><strong><%= student.individualPlan %>%</strong></article><article class="kpi"><span>DISSERTATSIYA</span><strong><%= student.dissertationProgress %>%</strong></article><article class="kpi"><span>ILMIY FAOLLIK</span><strong><%= student.scientificActivity %>%</strong></article><article class="kpi"><span>BITIRUV TAYYORLIGI</span><strong><%= student.graduationReadiness %>%</strong></article></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">AKADEMIK PROFIL</span><h2>Asosiy ma’lumotlar</h2></div></div><dl class="details"><dt>Fakultet</dt><dd><%= student.faculty||'—' %></dd><dt>Kafedra</dt><dd><%= student.department||'—' %></dd><dt>Mutaxassislik</dt><dd><%= student.specialty||'—' %></dd><dt>Guruh</dt><dd><%= student.group||'—' %></dd><dt>Kurs</dt><dd><%= student.course||'—' %></dd><dt>Qabul yili</dt><dd><%= student.admissionYear||'—' %></dd><dt>Ta’lim shakli</dt><dd><%= student.educationForm||'—' %></dd><dt>O‘qish holati</dt><dd><%= student.studyStatus||'active' %></dd><dt>Ilmiy rahbar</dt><dd><%= student.supervisor?.fullName||'Biriktirilmagan' %></dd><dt>Akademik qarz</dt><dd><%= student.academicDebtCount||0 %></dd><dt>Hujjatlar</dt><dd><%= student.documentsCompleteness||0 %>%</dd></dl></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">DISSERTATSIYA ROADMAP</span><h2><%= student.dissertationTitle||'Mavzu kiritilmagan' %></h2></div></div><div class="timeline"><% stages.forEach((st,i)=>{ const done=(i+1)<=student.dissertationStage; %><div><time><%= String(i+1).padStart(2,'0') %></time><p><b><%= st %></b><span><%= done?'Bosqichdan o‘tilgan':'Kutilmoqda' %></span></p><em class="status <%= done?'green':'yellow' %>"><%= done?'✓':'…' %></em></div><% }) %></div></article></section>

<% if(profileAccess.limited || profileAccess.full || profileAccess.self){ %><section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">ALOQA</span><h2>Kerakli kontaktlar</h2></div><span class="access-tag"><%= profileAccess.self?'Faqat men + vakolatli rollar':profileAccess.full?'To‘liq vakolat':'Ilmiy rahbar uchun' %></span></div><dl class="details"><dt>Telefon</dt><dd><%= student.phone||'—' %></dd><dt>E-mail</dt><dd><%= student.email||'—' %></dd><dt>Qo‘shimcha e-mail</dt><dd><%= student.secondaryEmail||'—' %></dd><dt>Telegram</dt><dd><%= student.telegram||'—' %></dd><% if(profileAccess.full||profileAccess.self){ %><dt>Qo‘shimcha telefon</dt><dd><%= student.alternatePhone||'—' %></dd><dt>Viloyat</dt><dd><%= student.region||'—' %></dd><dt>Tuman / shahar</dt><dd><%= student.district||'—' %></dd><dt>Hozirgi manzil</dt><dd><%= student.currentAddress||'—' %></dd><dt>Doimiy manzil</dt><dd><%= student.permanentAddress||'—' %></dd><dt>Favqulodda aloqa</dt><dd><%= student.emergencyContactName||'—' %> <small><%= student.emergencyContactRelation||'' %> · <%= student.emergencyContactPhone||'' %></small></dd><% } %></dl></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">ILMIY PROFIL</span><h2>Talaba kiritgan ma’lumotlar</h2></div></div><dl class="details"><dt>Ilmiy qiziqishlar</dt><dd><%= student.researchInterests||'—' %></dd><dt>ORCID</dt><dd><%= student.orcid||'—' %></dd><dt>Scholar</dt><dd><%= student.scholarUrl||'—' %></dd><dt>LinkedIn</dt><dd><%= student.linkedinUrl||'—' %></dd><dt>Oldingi OTM</dt><dd><%= student.previousUniversity||'—' %></dd><dt>Bakalavr mutaxassisligi</dt><dd><%= student.bachelorSpecialty||'—' %></dd><dt>Tillar</dt><dd><%= student.languages||'—' %></dd><dt>Bandlik</dt><dd><%= student.employmentStatus||'not_working' %> <% if(student.employer){ %>· <%= student.employer %> <% } %><% if(student.jobTitle){ %>· <%= student.jobTitle %><% } %></dd><dt>Profil to‘ldirilishi</dt><dd><b><%= student.profileCompleteness||0 %>%</b></dd><dt>Oxirgi yangilanish</dt><dd><%= student.profileUpdatedAt?new Date(student.profileUpdatedAt).toLocaleString('uz-UZ'):'—' %></dd></dl></article></section><% } else { %><section class="privacy-note"><b>🔒 Shaxsiy aloqa maydonlari yashirilgan</b><span>Bu rolga talabaning telefon, e-mail, manzil va favqulodda aloqa ma’lumotlari berilmaydi.</span></section><% if(profileAccess.academic){ %><section class="panel"><div class="panel-head"><div><span class="eyebrow">ILMIY PROFIL</span><h2>Akademik jihatdan kerakli ma’lumotlar</h2></div></div><dl class="details"><dt>Ilmiy qiziqishlar</dt><dd><%= student.researchInterests||'—' %></dd><dt>ORCID</dt><dd><%= student.orcid||'—' %></dd><dt>Scholar</dt><dd><%= student.scholarUrl||'—' %></dd><dt>Oldingi OTM</dt><dd><%= student.previousUniversity||'—' %></dd><dt>Bakalavr mutaxassisligi</dt><dd><%= student.bachelorSpecialty||'—' %></dd><dt>Tillar</dt><dd><%= student.languages||'—' %></dd></dl></section><% } %><% } %>

<% if(['superadmin','tech','magistracy','dean','department','supervisor','teacher'].includes(currentUser.role)){ %><section class="panel"><div class="panel-head"><div><span class="eyebrow">TEZKOR YANGILASH</span><h2>Monitoring ko‘rsatkichlari</h2></div></div><form method="post" action="/students/<%= student._id %>/progress" class="form-grid"><label>Davomat %<input type="number" name="attendance" min="0" max="100" value="<%= student.attendance %>"></label><label>O‘zlashtirish %<input type="number" name="academicScore" min="0" max="100" value="<%= student.academicScore %>"></label><label>Individual reja %<input type="number" name="individualPlan" min="0" max="100" value="<%= student.individualPlan %>"></label><label>Dissertatsiya %<input type="number" name="dissertationProgress" min="0" max="100" value="<%= student.dissertationProgress %>"></label><label>Ilmiy faollik %<input type="number" name="scientificActivity" min="0" max="100" value="<%= student.scientificActivity %>"></label><label>Hujjatlar %<input type="number" name="documentsCompleteness" min="0" max="100" value="<%= student.documentsCompleteness||0 %>"></label><label>Akademik qarz<input type="number" name="academicDebtCount" min="0" value="<%= student.academicDebtCount||0 %>"></label><label>Dissertatsiya bosqichi<select name="dissertationStage"><% stages.forEach((st,i)=>{ %><option value="<%= i+1 %>" <%= student.dissertationStage===i+1?'selected':'' %>><%= i+1 %>. <%= st %></option><% }) %></select></label><label class="wide">Izoh<textarea name="notes"><%= student.notes||'' %></textarea></label><div class="wide form-actions"><button class="primary">Monitoringni saqlash</button></div></form></section><% } %>
</main></div><%- include('../partials/foot') %>
