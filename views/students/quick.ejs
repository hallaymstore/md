<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="hero-line compact"><div><span class="eyebrow">OMMAVIY TEZ KIRITISH</span><h1>Bir guruhni bir necha daqiqada kiriting</h1><p>Akademik tuzilma bir marta tanlanadi. Pastda faqat F.I.Sh., ID va aloqa ma’lumotlarini yozasiz.</p></div><div class="hero-actions"><a class="secondary" href="/students/new">+ Bitta talaba</a><a class="ghost" href="/structure">⌘ Tuzilma katalogi</a></div></section>
<form method="post" action="/students/quick" id="quickStudentForm">
<section class="panel"><div class="section-title-row"><div><span class="eyebrow">UMUMIY PRESET</span><h2>Bu guruh uchun bir marta tanlang</h2></div><span class="badge">hamma qatorlarga qo‘llanadi</span></div>
<%- include('_academic-fields', { values: preset }) %>
</section>
<section class="grid-2"><div class="panel paste-panel"><div class="panel-head"><div><span class="eyebrow">EXCEL / WORDDAN</span><h2>Copy → Paste</h2><p>4 ustunni Excel’dan nusxalab shu yerga tashlang.</p></div></div><textarea id="pasteStudents" placeholder="F.I.Sh.    Talaba ID    Telefon    Email\nKarimov Aziz    2026001    +998...    a@qdt.uz"></textarea><div class="form-actions"><button type="button" class="secondary" id="applyPaste">Jadvalga joylash</button></div></div>
<div class="panel"><div class="panel-head"><div><span class="eyebrow">QULAYLIKLAR</span><h2>Tezlik uchun</h2></div></div><div class="feature-list"><div><i>↵</i><p><b>Enter bilan keyingi katak</b><span>Klaviaturadan uzilmay ishlash.</span></p></div><div><i>+</i><p><b>Qator qo‘shish</b><span>Kerak bo‘lsa 10 tadan ko‘proq talaba.</span></p></div><div><i>✓</i><p><b>Takroriy ID nazorati</b><span>Mavjud ID bo‘lsa o‘tkazib yuboriladi.</span></p></div></div></div></section>
<section class="panel"><div class="section-title-row"><div><span class="eyebrow">TALABALAR</span><h2>Faqat o‘zgaradigan ma’lumotlar</h2></div><button type="button" class="tiny-btn" id="addQuickRow">+ Qator</button></div><div class="table-wrap quick-entry-wrap"><table class="quick-entry-table"><thead><tr><th>#</th><th>F.I.Sh.</th><th>Talaba ID</th><th>Telefon</th><th>E-mail</th><th>Dissertatsiya mavzusi</th><th></th></tr></thead><tbody id="quickRows">
<% for(let i=0;i<10;i++){ %><tr data-quick-row><td class="row-no"><%= i+1 %></td><td><input name="rows[<%= i %>][fullName]" placeholder="F.I.Sh."></td><td><input name="rows[<%= i %>][studentId]" placeholder="ID"></td><td><input name="rows[<%= i %>][phone]" placeholder="+998"></td><td><input type="email" name="rows[<%= i %>][email]" placeholder="email"></td><td><input name="rows[<%= i %>][dissertationTitle]" placeholder="ixtiyoriy"></td><td><button type="button" class="icon-remove" data-remove-row>×</button></td></tr><% } %>
</tbody></table></div></section>
<div class="sticky-savebar"><div><b>Bir bosishda guruhni saqlang.</b><span>Bo‘sh qatorlar avtomatik e’tiborga olinmaydi.</span></div><div class="savebar-actions"><a class="ghost" href="/students">Bekor qilish</a><button class="secondary" name="submitAction" value="save-list">Saqlash va ro‘yxat</button><button class="primary" name="submitAction" value="stay">Saqlash + yana kiritish</button></div></div>
</form><script type="application/json" id="academicStructureData"><%- JSON.stringify(structures).replace(/</g,'\\u003c') %></script>
</main></div><%- include('../partials/foot') %>
