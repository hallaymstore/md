<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="hero-line compact"><div><span class="eyebrow">MAGISTRANT PROFILI</span><h1><%= student.fullName %></h1><p>Asosiy ma’lumot va akademik bog‘lanishni tahrirlash.</p></div><div class="hero-actions"><a class="ghost" href="/students/<%= student._id %>">← Profilga qaytish</a></div></section>
<form method="post" action="/students/<%= student._id %>/edit" data-student-entry>
<section class="panel"><div class="section-title-row"><div><span class="eyebrow">ASOSIY</span><h2>Shaxsiy ma’lumot</h2></div></div><div class="form-grid">
<label class="wide">F.I.Sh.<input name="fullName" required value="<%= student.fullName %>"></label><label>Talaba ID<input name="studentId" value="<%= student.studentId||'' %>" data-duplicate-field data-exclude-id="<%= student._id %>"></label><label>Foydalanuvchi hisobiga bog‘lash<select name="user"><option value="">Bog‘lanmagan</option><% studentAccounts.forEach(u=>{ %><option value="<%= u._id %>" <%= String(student.user||'')===String(u._id)?'selected':'' %>><%= u.fullName %> — <%= u.login %></option><% }) %></select></label>
</div><div class="duplicate-hint" data-duplicate-hint></div></section>
<section class="panel"><div class="section-title-row"><div><span class="eyebrow">AKADEMIK TUZILMA</span><h2>Tanlovlarni yangilash</h2></div></div><%- include('_academic-fields', { values: student }) %></section>
<section class="panel"><div class="form-grid"><label>Telefon<input name="phone" value="<%= student.phone||'' %>"></label><label>E-mail<input type="email" name="email" value="<%= student.email||'' %>"></label><label class="wide">Dissertatsiya mavzusi<input name="dissertationTitle" value="<%= student.dissertationTitle||'' %>"></label><label>O‘qish holati<select name="studyStatus"><% [['active','Faol'],['academic_leave','Akademik ta’til'],['graduated','Bitirgan'],['expelled','Chetlashtirilgan']].forEach(x=>{ %><option value="<%= x[0] %>" <%= student.studyStatus===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></label><label class="wide">Izoh<textarea name="notes"><%= student.notes||'' %></textarea></label></div></section>
<details class="panel advanced-details"><summary><b>Talaba kiritadigan aloqa va shaxsiy profil</b><span>Vakolatli xodim zarur bo‘lsa tuzatishi mumkin</span></summary><div class="form-grid monitoring-entry-grid"><label>Qo‘shimcha telefon<input name="alternatePhone" value="<%= student.alternatePhone||'' %>"></label><label>Telegram<input name="telegram" value="<%= student.telegram||'' %>"></label><label>Viloyat<input name="region" value="<%= student.region||'' %>"></label><label>Tuman / shahar<input name="district" value="<%= student.district||'' %>"></label><label class="wide">Hozirgi manzil<input name="currentAddress" value="<%= student.currentAddress||'' %>"></label><label class="wide">Doimiy manzil<input name="permanentAddress" value="<%= student.permanentAddress||'' %>"></label><label>Tug‘ilgan sana<input type="date" name="birthDate" value="<%= student.birthDate?new Date(student.birthDate).toISOString().slice(0,10):'' %>"></label><label>Favqulodda aloqa F.I.Sh.<input name="emergencyContactName" value="<%= student.emergencyContactName||'' %>"></label><label>Favqulodda telefon<input name="emergencyContactPhone" value="<%= student.emergencyContactPhone||'' %>"></label><label>ORCID<input name="orcid" value="<%= student.orcid||'' %>"></label><label class="wide">Ilmiy qiziqishlar<textarea name="researchInterests"><%= student.researchInterests||'' %></textarea></label><label class="wide">Scholar havolasi<input name="scholarUrl" value="<%= student.scholarUrl||'' %>"></label></div></details>
<div class="sticky-savebar"><div><b>O‘zgarishlarni tekshiring.</b><span>Monitoring foizlari profilning monitoring bo‘limida alohida boshqariladi.</span></div><div class="savebar-actions"><a class="ghost" href="/students/<%= student._id %>">Bekor qilish</a><button class="primary">O‘zgarishlarni saqlash</button></div></div>
</form><script type="application/json" id="academicStructureData"><%- JSON.stringify(structures).replace(/</g,'\\u003c') %></script>
</main></div><%- include('../partials/foot') %>
