<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="hero-line compact"><div><span class="eyebrow">MAGISTRANTLAR YAGONA BAZASI</span><h1>Magistrantlar</h1><p>Qidirish, kesimlar bo‘yicha filtrlash, ommaviy o‘zgartirish va tezkor kiritish.</p></div><% if(canEdit){ %><div class="hero-actions"><a class="secondary" href="/students/quick">⚡ Tezkor kiritish</a><a class="primary" href="/students/new">+ Magistrant</a></div><% } %></section>
<form class="filters filters-advanced" method="get"><input name="q" value="<%= filters.q||'' %>" placeholder="F.I.Sh., ID, guruh, mutaxassislik..."><select name="faculty"><option value="">Barcha fakultet</option><% faculties.forEach(v=>{ %><option <%= filters.faculty===v?'selected':'' %>><%= v %></option><% }) %></select><select name="department"><option value="">Barcha kafedra</option><% departments.forEach(v=>{ %><option <%= filters.department===v?'selected':'' %>><%= v %></option><% }) %></select><select name="specialty"><option value="">Barcha mutaxassislik</option><% specialties.forEach(v=>{ %><option <%= filters.specialty===v?'selected':'' %>><%= v %></option><% }) %></select><select name="group"><option value="">Barcha guruh</option><% groups.forEach(v=>{ %><option <%= filters.group===v?'selected':'' %>><%= v %></option><% }) %></select><select name="course"><option value="">Barcha kurs</option><option value="1" <%= filters.course==='1'?'selected':'' %>>1-kurs</option><option value="2" <%= filters.course==='2'?'selected':'' %>>2-kurs</option></select><select name="status"><option value="">Monitoring holati</option><option value="green" <%= filters.status==='green'?'selected':'' %>>Yashil</option><option value="yellow" <%= filters.status==='yellow'?'selected':'' %>>Sariq</option><option value="red" <%= filters.status==='red'?'selected':'' %>>Qizil</option></select><button class="secondary">Filtrlash</button><a class="ghost filter-export" href="/students/export.csv?<%= new URLSearchParams(filters).toString() %>">↓ Jadvalni yuklab olish</a></form>
<% if(canEdit){ %><form method="post" action="/students/bulk" id="bulkStudentsForm"><section class="bulk-toolbar" data-bulk-toolbar><div><b><span data-selected-count>0</span> ta tanlandi</b><span>Bir nechta magistrantga bir amalni qo‘llang.</span></div><select name="action" id="bulkAction"><option value="">Ommaviy amal</option><option value="supervisor">Ilmiy rahbarni almashtirish</option><option value="structure">Guruh/tuzilmani almashtirish</option><option value="studyStatus">O‘qish holatini almashtirish</option></select><select name="value" id="bulkValue"><option value="">Qiymatni tanlang</option></select><button class="primary">Qo‘llash</button></section><script type="application/json" id="bulkOptions"><%- JSON.stringify({supervisors:supervisors.map(s=>({id:s._id,name:s.fullName})),structures:structures.map(s=>({id:s._id,name:`${s.group} — ${s.specialty}`})),statuses:[{id:'active',name:'Faol'},{id:'academic_leave',name:'Akademik ta’til'},{id:'graduated',name:'Bitirgan'},{id:'expelled',name:'Chetlashtirilgan'}]}).replace(/</g,'\\u003c') %></script><% } %>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">NATIJA</span><h2><%= students.length %> ta magistrant</h2></div></div><div class="table-wrap"><table><thead><tr><% if(canEdit){ %><th><input type="checkbox" data-select-all></th><% } %><th>Magistrant</th><th>Mutaxassislik</th><th>Guruh</th><th>Ilmiy rahbar</th><th>Davomat</th><th>Reja</th><th>Dissertatsiya</th><th>Hujjat</th><th>Qarz</th><th>Holat</th><th></th></tr></thead><tbody><% students.forEach(s=>{ %><tr><% if(canEdit){ %><td><input type="checkbox" name="ids" value="<%= s._id %>" data-student-check></td><% } %><td><div class="table-person"><% if(s.user?._id){ %><a href="/profile/<%= s.user._id %>"><%- include('../partials/avatar', { user:s.user, size:'xs' }) %></a><% } else { %><%- include('../partials/avatar', { user:{role:'student',fullName:s.fullName}, size:'xs' }) %><% } %><div><b><%= s.fullName %></b><small><%= s.studentId||'ID yo‘q' %></small></div></div></td><td><%= s.specialty||'—' %><small><%= s.faculty||'—' %></small></td><td><%= s.group||'—' %></td><td><%= s.supervisor?.fullName||'Biriktirilmagan' %></td><td><%= s.attendance %>%</td><td><%= s.individualPlan %>%</td><td><%= s.dissertationProgress %>%</td><td><%= s.documentsCompleteness||0 %>%</td><td><%= s.academicDebtCount||0 %></td><td><span class="status <%= s.status %>"><%= s.status==='green'?'Barqaror':s.status==='yellow'?'Nazoratda':s.status==='red'?'Muammoli':s.status %></span></td><td><div class="row-actions"><a class="table-link" href="/students/<%= s._id %>">Akademik</a><% if(s.user?._id){ %><a class="table-link" href="/profile/<%= s.user._id %>">Ichki profil</a><% } %><% if(canEdit){ %><a class="tiny-btn" href="/students/<%= s._id %>/edit">Tahrirlash</a><% } %></div></td></tr><% }) %><% if(!students.length){ %><tr><td colspan="12"><div class="empty-state">Filtr bo‘yicha magistrant topilmadi.</div></td></tr><% } %></tbody></table></div></section>
<% if(canEdit){ %></form><% } %></main></div><%- include('../partials/foot') %>
