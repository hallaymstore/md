<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content">
<%- include('../partials/flash') %>
<section class="hero-line role-hero role-hero-system"><div><span class="eyebrow">MASTER DATA</span><h1>Akademik nomlar va tuzilma</h1><p>Fakultet, kafedra, mutaxassislik va guruh nomlari shu markazdan boshqariladi. Qolgan formalar bu nomlarni qo‘lda yozmaydi — katalogdan tanlaydi.</p></div><div class="hero-actions"><span class="badge <%= canWriteMaster?'green':'yellow' %>"><%= canWriteMaster?'Admin tahriri':'Faqat ko‘rish' %></span></div></section>

<section class="analytics-summary-strip">
  <div><span>FAKULTET</span><b><%= faculties.length %></b><small>kanonik nom</small></div>
  <div><span>KAFEDRA</span><b><%= departments.length %></b><small>faol katalog</small></div>
  <div><span>MUTAXASSISLIK</span><b><%= specialties.length %></b><small>tanlash variantlari</small></div>
  <div><span>GURUH</span><b><%= groups.length %></b><small>tezkor kiritish uchun</small></div>
</section>

<% if(canWriteMaster){ const uf=units.filter(x=>x.level==='faculty'); const ud=units.filter(x=>x.level==='department'); const us=units.filter(x=>x.level==='specialty'); const ug=units.filter(x=>x.level==='group'); %>
<section class="panel master-builder"><div class="panel-head"><div><span class="eyebrow">1-BOSQICH • MASTER NOMLAR</span><h2>Nomlarni avval to‘g‘ri ierarxiyada kiriting</h2><p>Fakultet alohida, keyin unga kafedra, kafedraga mutaxassislik, mutaxassislikka guruh bog‘lanadi. Talaba formasida faqat shu tasdiqlangan nomlar chiqadi.</p></div><span class="badge green">Faqat bosh admin</span></div>
<div class="grid-2">
<form method="post" action="/structure/unit" class="unit-card"><input type="hidden" name="level" value="faculty"><b>01 • Fakultet</b><label>Fakultet nomi<input name="name" required placeholder="Masalan: Energetika fakulteti"></label><button class="primary">+ Fakultet qo‘shish</button></form>
<form method="post" action="/structure/unit" class="unit-card"><input type="hidden" name="level" value="department"><b>02 • Kafedra</b><label>Fakultet<select name="parent" required><option value="">Tanlang</option><% uf.filter(x=>x.active).forEach(x=>{ %><option value="<%= x._id %>"><%= x.name %></option><% }) %></select></label><label>Kafedra nomi<input name="name" required></label><button class="primary">+ Kafedra qo‘shish</button></form>
<form method="post" action="/structure/unit" class="unit-card"><input type="hidden" name="level" value="specialty"><b>03 • Mutaxassislik</b><label>Kafedra<select name="parent" required><option value="">Tanlang</option><% ud.filter(x=>x.active).forEach(x=>{ %><option value="<%= x._id %>"><%= x.name %> — <%= x.parent?.name||'' %></option><% }) %></select></label><label>Mutaxassislik nomi<input name="name" required></label><button class="primary">+ Mutaxassislik qo‘shish</button></form>
<form method="post" action="/structure/unit" class="unit-card"><input type="hidden" name="level" value="group"><b>04 • Guruh</b><label>Mutaxassislik<select name="parent" required><option value="">Tanlang</option><% us.filter(x=>x.active).forEach(x=>{ %><option value="<%= x._id %>"><%= x.name %> — <%= x.parent?.name||'' %></option><% }) %></select></label><label>Guruh nomi<input name="name" required placeholder="MMT-520-25"></label><div class="form-grid"><label>Kurs<select name="course"><option>1</option><option>2</option><option>3</option></select></label><label>Qabul yili<input type="number" name="admissionYear" min="2000" max="2100"></label><label>Ta’lim shakli<select name="educationForm"><option>Magistratura</option><option>Kunduzgi</option><option>Kechki</option><option>Masofaviy</option></select></label><label>Standart rahbar<select name="defaultSupervisor"><option value="">Biriktirilmagan</option><% supervisors.forEach(x=>{ %><option value="<%= x._id %>"><%= x.fullName %></option><% }) %></select></label></div><button class="primary">+ Guruh qo‘shish</button></form>
</div></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">MASTER RO‘YXAT</span><h2>Fakultet → kafedra → mutaxassislik → guruh</h2></div><span class="badge"><%= units.length %> ta nom</span></div><div class="table-wrap"><table><thead><tr><th>Daraja</th><th>Nom</th><th>Ota bo‘lim</th><th>Holat</th><th>Amal</th></tr></thead><tbody><% units.forEach(u=>{ %><tr><td><span class="chip"><%= u.level %></span></td><td><b><%= u.name %></b></td><td><%= u.parent?.name||'—' %></td><td><span class="status <%= u.active?'green':'red' %>"><%= u.active?'Faol':'Yopiq' %></span></td><td><div class="row-actions"><button class="tiny-btn" onclick="document.getElementById('unit-<%= u._id %>').showModal()">Tahrirlash</button><form method="post" action="/structure/unit/<%= u._id %>/toggle"><button class="tiny-btn"><%= u.active?'Yopish':'Ochish' %></button></form><form method="post" action="/structure/unit/<%= u._id %>/delete" onsubmit="return confirm('Master nomni o‘chirishni tasdiqlaysizmi?')"><button class="tiny-btn danger-btn">O‘chirish</button></form></div><dialog id="unit-<%= u._id %>" class="modal"><form method="post" action="/structure/unit/<%= u._id %>/edit"><h3><%= u.name %></h3><label>Nom<input name="name" value="<%= u.name %>" required></label><% if(u.level==='group'){ %><div class="form-grid"><label>Kurs<input type="number" name="course" value="<%= u.course||1 %>" min="1" max="3"></label><label>Qabul yili<input type="number" name="admissionYear" value="<%= u.admissionYear||'' %>"></label><label>Ta’lim shakli<input name="educationForm" value="<%= u.educationForm||'Magistratura' %>"></label><label>Rahbar<select name="defaultSupervisor"><option value="">Biriktirilmagan</option><% supervisors.forEach(x=>{ %><option value="<%= x._id %>" <%= String(u.defaultSupervisor?._id||'')===String(x._id)?'selected':'' %>><%= x.fullName %></option><% }) %></select></label></div><% } %><small class="field-help">Ota bo‘limni xato bog‘lagan bo‘lsangiz, xavfsizlik uchun bu yozuvni o‘chirib qayta yarating.</small><div class="modal-actions"><button type="button" class="ghost" onclick="this.closest('dialog').close()">Bekor</button><button class="primary">Saqlash</button></div></form></dialog></td></tr><% }) %><% if(!units.length){ %><tr><td colspan="5" class="empty-state">Master nomlar hali kiritilmagan.</td></tr><% } %></tbody></table></div></section>
<% } %>

<% if(canWriteMaster){ %>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">MIGRATSIYA VA OMMAVIY TUZATISH</span><h2>Eski bazani master katalogga olib kelish</h2><p>V2.2 yoki oldingi bazadagi mavjud talabalar nomlarini master ierarxiyaga yig‘ing yoki xato nomni bir martada to‘g‘rilang.</p></div></div>
<div class="grid-2">
<form method="post" action="/structure/rename" class="form-grid one unit-card">
<b>Ommaviy nom almashtirish</b><label>Qaysi daraja?<select name="level" required><option value="faculty">Fakultet</option><option value="department">Kafedra</option><option value="specialty">Mutaxassislik</option><option value="group">Guruh</option></select></label>
<label>Eski nom<input name="oldValue" required list="allAcademicNames"></label><label>Yangi nom<input name="newValue" required></label>
<details class="advanced-details"><summary><b>Ixtiyoriy aniqlashtirish</b><span>Bir xil nomlar bo‘lsa scope kiriting</span></summary><div class="form-grid"><label>Fakultet<input name="faculty" list="facultyNames"></label><label>Kafedra<input name="department" list="departmentNames"></label><label>Mutaxassislik<input name="specialty" list="specialtyNames"></label></div></details>
<button class="primary" onclick="return confirm('Nomni butun bog‘langan ma’lumotlarda almashtirishni tasdiqlaysizmi?')">Nomni almashtirish</button></form>
<form method="post" action="/structure/sync" class="unit-card"><b>V2.2 bazasini avtomatik yig‘ish</b><p class="muted">Mavjud talabalardagi fakultet/kafedra/mutaxassislik/guruhlarni takrorlamasdan master katalogga aylantiradi.</p><button class="primary">Mavjud talabalardan master katalog yig‘ish</button></form>
</div></section>
<% } else { %>
<section class="quick-note warning-box"><div><b>Master-data himoyalangan</b><p>Texnik xodim va magistratura bu katalogni ko‘rishi mumkin, ammo fakultet/kafedra nomlarini faqat bosh administrator o‘zgartiradi. Shu tariqa barcha formadagi nomlar bir xil saqlanadi.</p></div></section>
<% } %>

<section class="panel"><div class="panel-head"><div><span class="eyebrow">KANONIK KATALOG</span><h2>Akademik yo‘nalishlar</h2></div><span class="badge"><%= structures.length %> ta</span></div>
<div class="table-wrap"><table><thead><tr><th>Fakultet</th><th>Kafedra</th><th>Mutaxassislik</th><th>Guruh</th><th>Kurs / yil</th><th>Rahbar</th><th>Talaba</th><th>Holat</th><% if(canWriteMaster){ %><th>Amal</th><% } %></tr></thead><tbody>
<% structures.forEach(x=>{ const key=[x.faculty,x.department,x.specialty,x.group].join('||'); %>
<tr><td><b><%= x.faculty %></b></td><td><%= x.department %></td><td><%= x.specialty %></td><td><span class="chip"><%= x.group %></span></td><td><%= x.course %>-kurs<small><%= x.admissionYear||'—' %> · <%= x.educationForm||'—' %></small></td><td><%= x.defaultSupervisor?.fullName||'—' %></td><td><b><%= usageMap[key]||0 %></b></td><td><span class="status <%= x.active?'green':'red' %>"><%= x.active?'Faol':'Yopiq' %></span></td>
<% if(canWriteMaster){ %><td><div class="row-actions"><button class="tiny-btn" onclick="document.getElementById('edit-<%= x._id %>').showModal()">Tahrirlash</button><form method="post" action="/structure/<%= x._id %>/toggle"><button class="tiny-btn"><%= x.active?'Yopish':'Faollashtirish' %></button></form><form method="post" action="/structure/<%= x._id %>/delete" onsubmit="return confirm('Bu foydalanilmayotgan yo‘nalishni o‘chirasizmi?')"><button class="tiny-btn danger-btn">O‘chirish</button></form></div>
<dialog id="edit-<%= x._id %>" class="modal wide-modal"><form method="post" action="/structure/<%= x._id %>/edit"><h3>Yo‘nalish sozlamalari</h3><p class="muted">Fakultet/kafedra/mutaxassislik/guruh nomini yuqoridagi Master ro‘yxatdan o‘zgartiring. Bu oynada faqat guruh presetlari boshqariladi.</p><input type="hidden" name="faculty" value="<%= x.faculty %>"><input type="hidden" name="department" value="<%= x.department %>"><input type="hidden" name="specialty" value="<%= x.specialty %>"><input type="hidden" name="group" value="<%= x.group %>"><div class="form-grid"><label>Kurs<input type="number" min="1" max="3" name="course" value="<%= x.course %>"></label><label>Qabul yili<input type="number" name="admissionYear" value="<%= x.admissionYear||'' %>"></label><label>Ta’lim shakli<input name="educationForm" value="<%= x.educationForm||'Magistratura' %>"></label><label>Rahbar<select name="defaultSupervisor"><option value="">Biriktirilmagan</option><% supervisors.forEach(s=>{ %><option value="<%= s._id %>" <%= String(x.defaultSupervisor?._id||'')===String(s._id)?'selected':'' %>><%= s.fullName %></option><% }) %></select></label></div><div class="modal-actions"><button type="button" class="ghost" onclick="this.closest('dialog').close()">Bekor</button><button class="primary">Saqlash</button></div></form></dialog></td><% } %>
</tr><% }) %>
<% if(!structures.length){ %><tr><td colspan="9" class="empty-state">Akademik katalog hali bo‘sh.</td></tr><% } %>
</tbody></table></div></section>

<datalist id="facultyNames"><% faculties.forEach(x=>{ %><option value="<%= x %>"><% }) %></datalist>
<datalist id="departmentNames"><% departments.forEach(x=>{ %><option value="<%= x %>"><% }) %></datalist>
<datalist id="specialtyNames"><% specialties.forEach(x=>{ %><option value="<%= x %>"><% }) %></datalist>
<datalist id="groupNames"><% groups.forEach(x=>{ %><option value="<%= x %>"><% }) %></datalist>
<datalist id="allAcademicNames"><% [...faculties,...departments,...specialties,...groups].forEach(x=>{ %><option value="<%= x %>"><% }) %></datalist>
</main></div><%- include('../partials/foot') %>
