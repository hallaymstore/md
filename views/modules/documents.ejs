<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><section class="hero-line"><div><span class="eyebrow">HUJJATLAR NAZORATI</span><h1>Hujjatlar monitoringi</h1><p>Individual reja, dissertatsiya mavzusi, rahbar, bayonnoma, attestatsiya va himoya hujjatlari.</p></div><a class="secondary" href="/uploads">Fayl markazi →</a></section>
<% if(['superadmin','tech','magistracy','dean','department','supervisor','teacher'].includes(currentUser.role)){ %><section class="panel"><form method="post" action="/documents" class="form-grid"><label>Magistrant<select name="student" required><option value="">Tanlang</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.fullName %> — <%= s.group||'—' %></option><% }) %></select></label><label>Hujjat turi<select name="type"><option value="individual_plan">Individual reja</option><option value="dissertation_topic">Dissertatsiya mavzusi</option><option value="supervisor_info">Ilmiy rahbar ma’lumoti</option><option value="seminar_minutes">Seminar bayonnomasi</option><option value="report">Hisobot</option><option value="publication">Ilmiy maqola</option><option value="conference">Konferensiya</option><option value="attestation">Attestatsiya</option><option value="defense">Himoya hujjati</option></select></label><label class="wide">Nomi<input name="title" required></label><label>Holat<select name="status"><option value="present">Mavjud</option><option value="update">Yangilanishi kerak</option><option value="missing">Mavjud emas</option></select></label><label>Sana<input type="date" name="issueDate"></label><label class="wide">Izoh<textarea name="notes"></textarea></label><div class="wide form-actions"><button class="primary">Holatni saqlash</button></div></form></section><% } %>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Magistrant</th><th>Hujjat</th><th>Holat</th><th>Sana</th><th>Yangilangan</th></tr></thead><tbody><% documents.forEach(d=>{ %><tr><td><b><%= d.student?.fullName||'—' %></b><small><%= d.student?.group||'—' %></small></td><td><%= d.title %><small><%= d.type %><% if(d.submission){ %> · <a class="table-link" href="/submissions/<%= d.submission._id %>"><%= d.submission.applicationNo %> →</a><% } %></small></td><td><span class="status <%= d.status==='present'?'green':d.status==='update'?'yellow':'red' %>"><%= d.status %></span></td><td><%= d.issueDate?new Date(d.issueDate).toLocaleDateString('uz-UZ'):'—' %></td><td><%= new Date(d.updatedAt).toLocaleDateString('uz-UZ') %></td></tr><% }) %></tbody></table></div></section></main></div><%- include('../partials/foot') %>
