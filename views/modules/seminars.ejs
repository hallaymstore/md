<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><section class="hero-line"><div><span class="eyebrow">SEMINAR MONITORING</span><h1>Seminarlar</h1><p>Rejalashtirilgan, o‘tkazilgan, bayonnoma va material holatini nazorat qilish.</p></div></section>
<% if(['superadmin','tech','magistracy','dean','department','supervisor','teacher'].includes(currentUser.role)){ %><section class="panel"><div class="panel-head"><div><span class="eyebrow">YANGI SEMINAR</span><h2>Seminar yaratish</h2></div></div><form method="post" action="/seminars" class="form-grid"><label class="wide">Mavzu<input name="title" required></label><label>Sana<input type="date" name="date" required></label><label>Holat<select name="status"><option value="planned">Rejada</option><option value="held">O‘tkazilgan</option><option value="cancelled">Bekor</option></select></label><label>Fakultet<input name="faculty" value="<%= currentUser.faculty||'' %>"></label><label>Kafedra<input name="department" value="<%= currentUser.department||'' %>"></label><label>Mas’ul<select name="responsible"><option value="">Tanlanmagan</option><% users.forEach(u=>{ %><option value="<%= u._id %>"><%= u.fullName %></option><% }) %></select></label><label>Ishtirokchilar<input type="number" name="participantCount" min="0" value="0"></label><label class="check"><input type="checkbox" name="minutesUploaded"> Bayonnoma mavjud</label><label class="check"><input type="checkbox" name="materialsUploaded"> Material yuklangan</label><label class="check"><input type="checkbox" name="photoUploaded"> Foto mavjud</label><label class="wide">Natija<textarea name="result"></textarea></label><div class="wide form-actions"><button class="primary">Saqlash</button></div></form></section><% } %>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">SEMINAR LEDGER</span><h2>Barcha seminarlar</h2></div></div><div class="table-wrap"><table><thead><tr><th>Sana</th><th>Mavzu</th><th>Kafedra</th><th>Mas’ul</th><th>Holat</th><th>Bayonnoma</th><th>Material</th><th>Foto</th><th>Amal</th></tr></thead><tbody><% seminars.forEach(s=>{ %><tr><td><%= new Date(s.date).toLocaleDateString('uz-UZ') %></td><td><b><%= s.title %></b><small><%= s.result||'' %></small></td><td><%= s.department||'—' %></td><td><%= s.responsible?.fullName||'—' %></td><td><span class="status <%= s.status==='held'?'green':s.status==='planned'?'yellow':'red' %>"><%= s.status %></span></td><td><%= s.minutesUploaded?'✓':'—' %></td><td><%= s.materialsUploaded?'✓':'—' %></td><td><%= s.photoUploaded?'✓':'—' %></td><td><% if(['superadmin','tech','magistracy','dean','department','supervisor','teacher'].includes(currentUser.role)){ %><form method="post" action="/seminars/<%= s._id %>" class="row-actions"><select name="status"><option value="planned" <%= s.status==='planned'?'selected':'' %>>Rejada</option><option value="held" <%= s.status==='held'?'selected':'' %>>O‘tkazildi</option><option value="cancelled" <%= s.status==='cancelled'?'selected':'' %>>Bekor</option></select><label class="check"><input type="checkbox" name="minutesUploaded" <%= s.minutesUploaded?'checked':'' %>>B</label><label class="check"><input type="checkbox" name="materialsUploaded" <%= s.materialsUploaded?'checked':'' %>>M</label><label class="check"><input type="checkbox" name="photoUploaded" <%= s.photoUploaded?'checked':'' %>>F</label><button class="tiny-btn">✓</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div></section></main></div><%- include('../partials/foot') %>
