<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><section class="hero-line"><div><span class="eyebrow">ILMIY FAOLIYAT</span><h1>Ilmiy faoliyat</h1><p>Maqolalar, konferensiyalar, tadqiqot va ilmiy seminarlar portfeli.</p></div></section>
<% if(['superadmin','tech','magistracy','dean','department','supervisor','teacher','student'].includes(currentUser.role)){ %><section class="panel"><form method="post" action="/science" class="form-grid"><label>Magistrant<select name="student" required><option value="">Tanlang</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.fullName %> — <%= s.group||'—' %></option><% }) %></select></label><label>Tur<select name="type"><option value="publication">Maqola</option><option value="conference">Konferensiya</option><option value="research">Tadqiqot</option><option value="seminar">Ilmiy seminar</option></select></label><label class="wide">Nomi<input name="title" required></label><label>Tashkilot / jurnal<input name="organization"></label><label>Sana<input type="date" name="date"></label><% if(currentUser.role!=='student'){ %><label>Holat<select name="status"><option value="planned">Rejada</option><option value="submitted">Yuborilgan</option><option value="accepted">Qabul qilingan</option><option value="published">Nashr qilingan</option><option value="completed">Bajarilgan</option></select></label><label>Baholash %<input type="number" name="score" min="0" max="100" value="0"></label><% } else { %><div class="wide secure-note">Magistrant yuborgan faoliyat “submitted” holatida saqlanadi va mas’ul xodim baholaydi.</div><% } %><label class="wide">Havola<input name="link"></label><div class="wide form-actions"><button class="primary">Faoliyatni qo‘shish</button></div></form></section><% } %>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Magistrant</th><th>Tur</th><th>Nomi</th><th>Tashkilot</th><th>Sana</th><th>Holat</th><th>Ball</th><th>Amal</th></tr></thead><tbody><% activities.forEach(a=>{ %><tr><td><b><%= a.student?.fullName||'—' %></b><small><%= a.student?.group||'—' %></small></td><td><span class="chip"><%= a.type %></span></td><td><%= a.title %><% if(a.submission){ %><small><a class="table-link" href="/submissions/<%= a.submission._id %>"><%= a.submission.applicationNo %> →</a></small><% } %></td><td><%= a.organization||'—' %></td><td><%= a.date?new Date(a.date).toLocaleDateString('uz-UZ'):'—' %></td><td><span class="status <%= ['accepted','published','completed'].includes(a.status)?'green':a.status==='submitted'?'yellow':'yellow' %>"><%= a.status %></span></td><td><%= a.score %>%</td><td><% if(['superadmin','tech','magistracy','dean','department','supervisor','teacher'].includes(currentUser.role)){ %><form method="post" action="/science/<%= a._id %>" class="row-actions"><select name="status"><option value="submitted">Yuborilgan</option><option value="accepted">Qabul</option><option value="published">Nashr</option><option value="completed">Bajarildi</option></select><input type="number" name="score" min="0" max="100" value="<%= a.score %>" style="width:70px"><button class="tiny-btn">✓</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div></section></main></div><%- include('../partials/foot') %>
