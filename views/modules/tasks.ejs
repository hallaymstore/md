<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><section class="hero-line"><div><span class="eyebrow">MUAMMO → TOPSHIRIQ → NAZORAT</span><h1>Muammolar va topshiriqlar</h1><p>Aniqlangan muammoni mas’ulga biriktirish, muddat belgilash va yopilishigacha kuzatish.</p></div></section>
<% if(['superadmin','tech','magistracy','dean','department','supervisor','teacher'].includes(currentUser.role)){ %><section class="panel"><form method="post" action="/tasks" class="form-grid"><label class="wide">Topshiriq<input name="title" required></label><label>Tur<select name="type"><option value="attendance">Davomat</option><option value="plan">Individual reja</option><option value="dissertation">Dissertatsiya</option><option value="seminar">Seminar</option><option value="document">Hujjat</option><option value="academic">O‘zlashtirish</option><option value="publication">Maqola</option><option value="conference">Konferensiya</option><option value="other">Boshqa</option></select></label><label>Ustuvorlik<select name="priority"><option value="low">Past</option><option value="medium">O‘rta</option><option value="high">Yuqori</option><option value="critical">Kritik</option></select></label><label>Magistrant<select name="student"><option value="">Umumiy</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.fullName %></option><% }) %></select></label><label>Mas’ul<select name="assignedTo"><option value="">Tanlanmagan</option><% assignees.forEach(u=>{ %><option value="<%= u._id %>"><%= u.fullName %> — <%= u.role %></option><% }) %></select></label><label>Muddat<input type="date" name="dueDate"></label><label class="wide">Izoh<textarea name="description"></textarea></label><div class="wide form-actions"><button class="primary">Topshiriq yaratish</button></div></form></section><% } %>
<section class="task-board"><% ['new','in_progress','resolved'].forEach(st=>{ %><article class="panel task-column"><div class="panel-head"><div><span class="eyebrow"><%= st %></span><h2><%= st==='new'?'Yangi':st==='in_progress'?'Jarayonda':'Yopilgan' %></h2></div><span class="badge"><%= tasks.filter(t=>t.status===st).length %></span></div><div class="task-list"><% tasks.filter(t=>t.status===st).forEach(t=>{ %><div class="task-card"><div class="task-top"><span class="priority <%= t.priority %>"><%= t.priority %></span><small><%= t.dueDate?new Date(t.dueDate).toLocaleDateString('uz-UZ'):'Muddat yo‘q' %></small></div><b><%= t.title %></b><p><%= t.description||'' %></p><span><%= t.student?.fullName||'Umumiy' %> · <%= t.assignedTo?.fullName||'Mas’ul yo‘q' %></span><form method="post" action="/tasks/<%= t._id %>" class="task-actions"><select name="status"><option value="new" <%= t.status==='new'?'selected':'' %>>Yangi</option><option value="in_progress" <%= t.status==='in_progress'?'selected':'' %>>Jarayonda</option><option value="resolved" <%= t.status==='resolved'?'selected':'' %>>Yopildi</option></select><button class="tiny-btn">Saqlash</button></form></div><% }) %></div></article><% }) %></section></main></div><%- include('../partials/foot') %>
