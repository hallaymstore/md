<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line timetable-hero"><div><span class="eyebrow">ADMIN / TEXNIK · EXCEL IMPORT</span><h1>Dars jadvalini Excel orqali yuklash</h1><p>Shablonni to‘ldiring, faylni yuklang va tizim uni bazaga yozishdan oldin tekshiradi. Xato, dublikat va to‘qnashuvlar alohida ko‘rsatiladi.</p></div><div class="hero-actions"><a class="ghost btn-link" href="/timetable">← Jadvalga qaytish</a><a class="primary btn-link" href="/timetable/import/template">⇩ Excel shablon</a></div></section>
<section class="excel-flow-grid"><article class="panel excel-step"><span class="step-no">1</span><div><b>Shablonni yuklab oling</b><p>Ustun nomlari va namunalar tayyor. O‘qituvchi loginini kiritish tavsiya etiladi.</p></div></article><article class="panel excel-step"><span class="step-no">2</span><div><b>Excel faylni yuklang</b><p>Faqat .xlsx. Bir importda maksimal 2 500 satr, fayl hajmi 8 MB gacha.</p></div></article><article class="panel excel-step"><span class="step-no">3</span><div><b>Preview va tasdiqlash</b><p>To‘qnashuvlarni ko‘ring. Faqat “Tayyor” satrlar bazaga yoziladi.</p></div></article></section>
<section class="panel excel-upload-panel no-print"><div class="panel-head"><div><span class="eyebrow">YANGI IMPORT</span><h2>Excel faylni tanlang</h2></div><span class="status-pill info">.XLSX</span></div><form method="post" action="/timetable/import/preview" enctype="multipart/form-data" class="excel-upload-form"><label class="excel-dropzone" for="timetableFile"><span class="excel-icon">▦</span><b>Excel faylni bu yerga tanlang</b><small id="excelFileName">MD-dars-jadvali.xlsx · maksimal 8 MB</small><input id="timetableFile" name="timetableFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required></label><div class="excel-upload-actions"><label>Import rejimi<select name="mode"><option value="merge">Birlashtirish — xavfsiz</option><option value="replace_groups">Fayldagi guruhlar jadvalini almashtirish</option></select></label><button class="primary" type="submit">Tekshirish va preview →</button></div></form><div class="excel-help"><b>Qabul qilinadigan ustunlar:</b> O‘quv yili, Semestr, Hafta turi, Kun, Para, Boshlanish, Tugash, Fan, Mashg‘ulot turi, Guruh, O‘qituvchi login, O‘qituvchi F.I.Sh., Xona, Fakultet, Kafedra, Izoh.</div></section>
<% if(draft){ const c=draft.counts||{}; %><section class="panel import-summary-panel"><div class="panel-head"><div><span class="eyebrow">PREVIEW</span><h2><%= draft.originalname %></h2><p><%= draft.sheetName %> varag‘i · <%= c.total||0 %> satr</p></div><form method="post" action="/timetable/import/cancel"><button class="tiny-btn danger" type="submit">Previewni bekor qilish</button></form></div><div class="import-kpis"><div class="import-kpi ok"><span>Tayyor</span><b><%= c.ready||0 %></b><small>import qilinadi</small></div><div class="import-kpi duplicate"><span>Dublikat</span><b><%= c.duplicate||0 %></b><small>o‘tkazib yuboriladi</small></div><div class="import-kpi conflict"><span>Konflikt</span><b><%= c.conflict||0 %></b><small>tuzatish kerak</small></div><div class="import-kpi error"><span>Xato</span><b><%= c.error||0 %></b><small>tuzatish kerak</small></div></div>
<% if((c.ready||0)>0 && !(draft.mode==='replace_groups' && ((c.error||0)+(c.conflict||0)>0))){ %><form method="post" action="/timetable/import/confirm" class="import-confirm-box no-print" onsubmit="return confirm('<%= draft.mode==='replace_groups' ? 'Fayldagi guruhlarning mavjud jadvali o‘chirilib, yangi jadval bilan almashtiriladi. Davom etasizmi?' : 'Tayyor satrlarni jadvalga import qilasizmi?' %>')"><div class="import-mode-card"><span>Import rejimi</span><b><%= draft.mode==='replace_groups'?'Guruhlar jadvalini almashtirish':'Birlashtirish — xavfsiz' %></b></div><div class="confirm-copy"><% if(draft.mode==='replace_groups'){ %>Fayldagi guruhlarning aynan mos <b>o‘quv yili va semestr</b> jadvali qayta yaratiladi. Boshqa guruhlar o‘zgarmaydi.<% } else { %>Mavjud jadval saqlanadi va faqat yangi, konfliktsiz satrlar qo‘shiladi.<% } %></div><button class="primary" type="submit">✓ <%= c.ready||0 %> ta darsni import qilish</button></form><% } else if(draft.mode==='replace_groups' && ((c.error||0)+(c.conflict||0)>0)){ %><div class="replace-blocked"><b>Almashtirish hozir bloklangan.</b> Xato yoki boshqa guruh/o‘qituvchi/xona bilan konflikt bor. Excelni tuzatib qayta preview qiling — shunda mavjud jadval tasodifan qisman o‘chmaydi.</div><% } %></section>
<section class="panel import-preview-panel"><div class="panel-head"><div><span class="eyebrow">SATRLAR TEKSHIRUVI</span><h2>Import natijasi</h2></div><div class="preview-filter-buttons"><button type="button" class="tiny-btn active" data-import-filter="all">Barchasi</button><button type="button" class="tiny-btn" data-import-filter="ready">Tayyor</button><button type="button" class="tiny-btn" data-import-filter="problem">Muammo</button></div></div><div class="table-wrap import-preview-wrap"><table class="import-preview-table"><thead><tr><th>#</th><th>Holat</th><th>Kun / para</th><th>Fan</th><th>Guruh</th><th>O‘qituvchi</th><th>Xona</th><th>Hafta</th><th>Izoh</th></tr></thead><tbody><% draft.rows.forEach(r=>{ const statusLabel=r.status==='ready'?'Tayyor':r.status==='duplicate'?'Dublikat':r.status==='conflict'?'Konflikt':'Xato'; %><tr data-import-status="<%= r.status %>"><td><%= r.excelRow %></td><td><span class="import-status <%= r.status %>"><%= statusLabel %></span></td><td><b><%= DAYS.find(d=>d.no===Number(r.day))?.short||r.day||'—' %></b> · <%= r.period||'—' %>-para<small><%= r.startTime||'—' %>–<%= r.endTime||'—' %></small></td><td><b><%= r.subject||'—' %></b><small><%= LESSON_TYPES[r.lessonType]||r.lessonType||'—' %></small></td><td><%= r.group||'—' %></td><td><%= r.teacherName||'—' %></td><td><%= r.room||'—' %></td><td><%= r.weekType==='all'?'Har hafta':r.weekType==='odd'?'Toq':r.weekType==='even'?'Juft':'—' %></td><td class="import-message"><%= (r.messages||[]).join(' ')||'Tekshiruvdan o‘tdi.' %></td></tr><% }) %></tbody></table></div></section><% } %>
<% if(history && history.length){ %><section class="panel import-history-panel"><div class="panel-head"><div><span class="eyebrow">AUDIT</span><h2>So‘nggi Excel importlar</h2></div></div><div class="table-wrap"><table><thead><tr><th>Sana</th><th>Fayl</th><th>Operator</th><th>Holat</th><th>Satrlar</th><th>Import</th><th>Rejim</th></tr></thead><tbody><% history.forEach(h=>{ %><tr><td><%= new Date(h.createdAt).toLocaleString('uz-UZ') %></td><td><b><%= h.filename||'—' %></b><small><%= h.sheetName||'' %></small></td><td><%= h.createdBy?.fullName||currentUser.fullName %></td><td><span class="status-pill <%= h.status==='completed'?'success':h.status==='failed'?'danger':'info' %>"><%= h.status==='completed'?'Yakunlangan':h.status==='failed'?'Xato':h.status==='cancelled'?'Bekor':'Preview' %></span></td><td><%= h.totalRows||0 %></td><td><%= h.importedRows||0 %></td><td><%= h.mode==='replace_groups'?'Almashtirish':'Birlashtirish' %></td></tr><% }) %></tbody></table></div></section><% } %>
<script>(function(){const input=document.getElementById('timetableFile'),name=document.getElementById('excelFileName');if(input&&name)input.addEventListener('change',()=>{name.textContent=input.files?.[0]?`${input.files[0].name} · ${(input.files[0].size/1024/1024).toFixed(2)} MB`:'MD-dars-jadvali.xlsx · maksimal 8 MB';});document.querySelectorAll('[data-import-filter]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-import-filter]').forEach(b=>b.classList.remove('active'));btn.classList.add('active');const filter=btn.dataset.importFilter;document.querySelectorAll('[data-import-status]').forEach(row=>{const s=row.dataset.importStatus;row.style.display=(filter==='all'||filter===s||(filter==='problem'&&s!=='ready'))?'':'none';});}));})();</script>
</main></div><%- include('../partials/foot') %>
