<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line"><div><span class="eyebrow">DARS JADVALI BOSHQARUVI</span><h1><%= entry?'Jadvalni tahrirlash':'Yangi dars qo‘shish' %></h1><p>Guruh, o‘qituvchi va xona bir vaqtda band bo‘lsa MD saqlashdan oldin to‘qnashuvni ko‘rsatadi.</p></div><div class="hero-actions"><a class="ghost btn-link" href="/timetable">← Jadvalga qaytish</a></div></section>
<section class="panel timetable-editor"><form method="post" action="<%= entry?'/timetable/'+entry._id:'/timetable' %>" class="form-grid">
<label>O‘quv yili<input name="academicYear" required value="<%= entry?.academicYear||defaultAcademicYear %>" placeholder="2026/2027"></label>
<label>Semestr<select name="semester"><option value="1" <%= (entry?.semester||defaultSemester)===1?'selected':'' %>>1-semestr</option><option value="2" <%= (entry?.semester||defaultSemester)===2?'selected':'' %>>2-semestr</option></select></label>
<label>Hafta turi<select name="weekType"><option value="all" <%= !entry||entry.weekType==='all'?'selected':'' %>>Har hafta</option><option value="odd" <%= entry?.weekType==='odd'?'selected':'' %>>Toq hafta</option><option value="even" <%= entry?.weekType==='even'?'selected':'' %>>Juft hafta</option></select></label>
<label>Kun<select name="day"><% DAYS.forEach(d=>{ %><option value="<%= d.no %>" <%= Number(entry?.day||1)===d.no?'selected':'' %>><%= d.name %></option><% }) %></select></label>
<label>Para<select name="period" id="ttPeriod"><% PERIODS.forEach(p=>{ %><option value="<%= p.no %>" data-start="<%= p.start %>" data-end="<%= p.end %>" <%= Number(entry?.period||1)===p.no?'selected':'' %>><%= p.no %>-para · <%= p.start %>–<%= p.end %></option><% }) %></select></label>
<label>Boshlanish<input type="time" name="startTime" id="ttStart" value="<%= entry?.startTime||PERIODS.find(p=>p.no===Number(entry?.period||1))?.start||'08:30' %>"></label><label>Tugash<input type="time" name="endTime" id="ttEnd" value="<%= entry?.endTime||PERIODS.find(p=>p.no===Number(entry?.period||1))?.end||'09:50' %>"></label>
<label class="wide">Fan nomi<input name="subject" required value="<%= entry?.subject||'' %>" placeholder="Masalan: Ilmiy tadqiqot metodologiyasi"></label>
<label>Dars turi<select name="lessonType"><% Object.entries(LESSON_TYPES).forEach(([key,label])=>{ %><option value="<%= key %>" <%= (entry?.lessonType||'lecture')===key?'selected':'' %>><%= label %></option><% }) %></select></label>
<label>Guruh<select name="group" required><option value="">Guruhni tanlang</option><% groups.forEach(g=>{ %><option value="<%= g %>" <%= entry?.group===g?'selected':'' %>><%= g %></option><% }) %></select></label>
<label>O‘qituvchi<select name="teacher"><option value="">Biriktirilmagan</option><% teachers.forEach(t=>{ %><option value="<%= t._id %>" <%= entry?.teacher&&String(entry.teacher)===String(t._id)?'selected':'' %>><%= t.fullName %></option><% }) %></select></label>
<label>Xona<input name="room" value="<%= entry?.room||'' %>" placeholder="B-204"></label><label class="wide">Izoh<textarea name="note" placeholder="Ixtiyoriy izoh"><%= entry?.note||'' %></textarea></label>
<label class="check"><input type="checkbox" name="active" <%= entry?.active===false?'':'checked' %>> Jadvalda faol ko‘rinsin</label><div class="wide form-actions"><button class="primary"><%= entry?'O‘zgarishni saqlash':'Jadvalga qo‘shish' %></button><a class="ghost btn-link" href="/timetable">Bekor qilish</a></div>
</form></section></main></div>
<script>(function(){var p=document.getElementById('ttPeriod'),s=document.getElementById('ttStart'),e=document.getElementById('ttEnd');if(!p)return;p.addEventListener('change',function(){var o=p.options[p.selectedIndex];if(o){s.value=o.dataset.start||s.value;e.value=o.dataset.end||e.value;}})})();</script><%- include('../partials/foot') %>
