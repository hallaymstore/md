<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line timetable-hero"><div><span class="eyebrow">EDUPAGE USLUBIDAGI HAFTALIK KO‘RINISH</span><h1>Dars jadvali</h1><p>Guruh, o‘qituvchi yoki xona bo‘yicha bir qarashda ko‘rinadigan rangli haftalik jadval. To‘qnashuvlar yaratish paytida avtomatik tekshiriladi.</p></div><div class="hero-actions"><button type="button" class="ghost" onclick="window.print()">⎙ Chop etish</button><% if(['superadmin','tech'].includes(currentUser.role)){ %><a class="ghost btn-link" href="/timetable/import">▦ Excel import</a><% } %><% if(canEdit){ %><a class="primary btn-link" href="/timetable/new?date=<%= date %>">+ Dars qo‘shish</a><% } %></div></section>

<section class="panel timetable-toolbar no-print"><form method="get" class="tt-filter-form">
<input type="hidden" name="date" value="<%= date %>">
<label>Ko‘rinish<select name="view" onchange="this.form.submit()" <%= currentUser.role==='student'||['teacher','supervisor'].includes(currentUser.role)?'disabled':'' %>><option value="group" <%= view==='group'?'selected':'' %>>Guruhlar</option><option value="teacher" <%= view==='teacher'?'selected':'' %>>O‘qituvchilar</option><option value="room" <%= view==='room'?'selected':'' %>>Xonalar</option></select></label>
<label><%= view==='group'?'Guruh':view==='teacher'?'O‘qituvchi':'Xona' %><select name="selected" onchange="this.form.submit()" <%= currentUser.role==='student'||['teacher','supervisor'].includes(currentUser.role)?'disabled':'' %>><% if(view==='group'){ groups.forEach(g=>{ %><option value="<%= g %>" <%= selected===g?'selected':'' %>><%= g %></option><% }) } else if(view==='teacher'){ teachers.forEach(t=>{ %><option value="<%= t._id %>" <%= selected===String(t._id)?'selected':'' %>><%= t.fullName %></option><% }) } else { rooms.forEach(r=>{ %><option value="<%= r %>" <%= selected===r?'selected':'' %>><%= r %></option><% }) } %></select><% if(currentUser.role==='student'||['teacher','supervisor'].includes(currentUser.role)){ %><input type="hidden" name="selected" value="<%= selected %>"><input type="hidden" name="view" value="<%= view %>"><% } %></label>
<label>O‘quv yili<input name="academicYear" value="<%= academicYear %>"></label><label>Semestr<select name="semester" onchange="this.form.submit()"><option value="1" <%= semester===1?'selected':'' %>>1-semestr</option><option value="2" <%= semester===2?'selected':'' %>>2-semestr</option></select></label><button class="tiny-btn">Ko‘rsatish</button>
</form></section>

<section class="week-nav panel no-print"><a class="icon-btn" href="/timetable?view=<%= view %>&selected=<%= encodeURIComponent(selected) %>&academicYear=<%= encodeURIComponent(academicYear) %>&semester=<%= semester %>&date=<%= prevDate %>">←</a><div><span><%= weekNo %>-hafta · <%= weekParity==='odd'?'Toq hafta':'Juft hafta' %></span><b><%= new Date(weekDates[0].date+'T12:00:00Z').toLocaleDateString('uz-UZ',{day:'2-digit',month:'long'}) %> — <%= new Date(weekDates[5].date+'T12:00:00Z').toLocaleDateString('uz-UZ',{day:'2-digit',month:'long',year:'numeric'}) %></b></div><a class="ghost btn-link" href="/timetable?view=<%= view %>&selected=<%= encodeURIComponent(selected) %>&academicYear=<%= encodeURIComponent(academicYear) %>&semester=<%= semester %>&date=<%= today %>">Bugun</a><a class="icon-btn" href="/timetable?view=<%= view %>&selected=<%= encodeURIComponent(selected) %>&academicYear=<%= encodeURIComponent(academicYear) %>&semester=<%= semester %>&date=<%= nextDate %>">→</a></section>

<section class="panel timetable-panel"><div class="tt-caption"><div><span class="eyebrow"><%= view==='group'?'GURUH':view==='teacher'?'O‘QITUVCHI':'XONA' %></span><h2><%= view==='teacher'?(teachers.find(t=>String(t._id)===selected)?.fullName||currentUser.fullName||'Tanlanmagan'):(selected||'Tanlanmagan') %></h2></div><div class="tt-legend"><span><i class="c0"></i>Ma’ruza</span><span><i class="c2"></i>Amaliyot</span><span><i class="c4"></i>Laboratoriya</span><span><i class="c6"></i>Seminar / onlayn</span></div></div>
<div class="timetable-scroll"><div class="timetable-grid" style="--tt-cols:<%= PERIODS.length %>"><div class="tt-corner"><b>Kun</b><small>Para</small></div><% PERIODS.forEach(p=>{ %><div class="tt-period-head"><b><%= p.no %></b><small><%= p.start %>–<%= p.end %></small></div><% }) %><% weekDates.forEach(day=>{ %><div class="tt-day-head <%= day.date===today?'is-today':'' %>"><b><%= day.short %></b><span><%= day.name %></span><small><%= new Date(day.date+'T12:00:00Z').toLocaleDateString('uz-UZ',{day:'2-digit',month:'2-digit'}) %></small></div><% PERIODS.forEach(p=>{ const items=grid[`${day.no}:${p.no}`]||[]; %><div class="tt-cell <%= day.date===today?'is-today-col':'' %>"><% if(items.length){ items.forEach(item=>{ %><article class="tt-lesson color-<%= item.colorIndex %>"><div class="tt-lesson-top"><span><%= LESSON_TYPES[item.lessonType]||item.lessonType %></span><small><%= item.weekType==='odd'?'Toq':item.weekType==='even'?'Juft':'' %></small></div><h3><%= item.subject %></h3><p><b><%= item.teacher?.fullName||item.teacherName||'O‘qituvchi biriktirilmagan' %></b></p><div class="tt-meta"><span>⌂ <%= item.room||'Xona —' %></span><span>◉ <%= item.group %></span></div><small class="tt-time"><%= item.startTime||p.start %>–<%= item.endTime||p.end %></small><% if(canEdit){ %><a class="tt-edit no-print" href="/timetable/<%= item._id %>/edit" title="Tahrirlash">✎</a><% } %></article><% }) } else { %><span class="tt-empty">—</span><% } %></div><% }) %><% }) %></div></div></section>

<% if(canEdit && entries.length){ %><section class="panel no-print"><div class="panel-head"><div><span class="eyebrow">BOSHQARUV</span><h2>Ko‘rinayotgan darslar</h2></div></div><div class="table-wrap"><table><thead><tr><th>Kun / para</th><th>Fan</th><th>Guruh</th><th>O‘qituvchi</th><th>Xona</th><th>Hafta</th><th>Amal</th></tr></thead><tbody><% entries.forEach(item=>{ %><tr><td><%= DAYS.find(d=>d.no===item.day)?.name %> · <%= item.period %>-para</td><td><b><%= item.subject %></b><small><%= LESSON_TYPES[item.lessonType] %></small></td><td><%= item.group %></td><td><%= item.teacher?.fullName||item.teacherName||'—' %></td><td><%= item.room||'—' %></td><td><%= item.weekType==='all'?'Har hafta':item.weekType==='odd'?'Toq':'Juft' %></td><td><div class="row-actions"><a class="tiny-btn" href="/timetable/<%= item._id %>/edit">Tahrir</a><form method="post" action="/timetable/<%= item._id %>/delete" onsubmit="return confirm('Darsni jadvaldan olib tashlaysizmi?')"><button class="tiny-btn danger">O‘chirish</button></form></div></td></tr><% }) %></tbody></table></div></section><% } %>
</main></div><%- include('../partials/foot') %>
