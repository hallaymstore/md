<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line compact"><div><span class="eyebrow">NAZORAT MARKAZI</span><h1>Monitoring markazi</h1><p>Ma’lumot → tahlil → muammo → topshiriq → qayta nazorat.</p></div></section>
<section class="grid-2">
<article class="panel danger-panel"><div class="panel-head"><div><span class="eyebrow">AVTOMATIK OGOHLANTIRISH</span><h2>Diqqat talab qiladiganlar</h2></div><span class="badge red"><%= alerts.length %></span></div><div class="alert-list"><% alerts.slice(0,20).forEach(s=>{ %><a href="/students/<%= s._id %>"><i class="dot red"></i><div><b><%= s.fullName %></b><span><%= s.group || '—' %> · Davomat <%= s.attendance %>% · Reja <%= s.individualPlan %>% · Diss. <%= s.dissertationProgress %>%</span></div><strong>→</strong></a><% }) %><% if (!alerts.length) { %><div class="empty">Muammoli indikator topilmadi.</div><% } %></div></article>
<% if (['superadmin','tech','magistracy','dean','department','supervisor','teacher'].includes(currentUser.role)) { %>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">YANGI MONITORING YOZUVI</span><h2>Faoliyatni qayd etish</h2></div></div><form method="post" action="/monitoring/items" class="form-grid one"><label>Magistrant<select name="student" required><option value="">Tanlang</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.fullName %> — <%= s.group || '—' %></option><% }) %></select></label><label>Tur<select name="type"><option value="attendance">Davomat</option><option value="plan">Individual reja</option><option value="dissertation">Dissertatsiya</option><option value="seminar">Seminar</option><option value="publication">Maqola</option><option value="conference">Konferensiya</option><option value="research">Tadqiqot</option><option value="supervision">Rahbar uchrashuvi</option><option value="document">Hujjat</option><option value="academic">O‘zlashtirish</option></select></label><label>Nomi<input name="title" required placeholder="Masalan: 2-semestr ilmiy seminar"></label><div class="form-grid"><label>Reja<input type="number" name="planned" value="0"></label><label>Bajarildi<input type="number" name="completed" value="0"></label><label>Foiz<input type="number" name="percent" min="0" max="100" value="0"></label><label>Muddat<input type="date" name="dueDate"></label></div><label>Izoh<textarea name="comment"></textarea></label><button class="primary">Qayd etish</button></form></article>
<% } %></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">FAOLIYAT TARIXI</span><h2>Monitoring jurnali</h2></div></div><div class="table-wrap"><table><thead><tr><th>Magistrant</th><th>Tur</th><th>Faoliyat</th><th>Foiz</th><th>Holat</th><th>Muddat</th><th>Yangilangan</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.student?.fullName || '—' %></b><small><%= i.student?.group || '—' %></small></td><td><span class="chip"><%= ({attendance:'Davomat',plan:'Individual reja',dissertation:'Dissertatsiya',seminar:'Seminar',publication:'Maqola',conference:'Konferensiya',research:'Tadqiqot',supervision:'Rahbar uchrashuvi',document:'Hujjat',academic:'O‘zlashtirish'}[i.type]||i.type) %></span></td><td><%= i.title %></td><td><%= i.percent %>%</td><td><span class="status <%= i.status %>"><%= ({green:'Barqaror',yellow:'Nazoratda',red:'Muammoli',planned:'Rejada',in_progress:'Jarayonda',completed:'Bajarilgan'}[i.status]||i.status) %></span></td><td><%= i.dueDate ? new Date(i.dueDate).toLocaleDateString('uz-UZ') : '—' %></td><td><%= new Date(i.updatedAt).toLocaleString('uz-UZ') %></td></tr><% }) %></tbody></table></div></section>
</main></div><%- include('../partials/foot') %>
