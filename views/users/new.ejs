<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content narrow">
<%- include('../partials/flash') %>
<section class="panel wizard-panel"><div class="panel-head"><div><span class="eyebrow">TEZKOR HISOB YARATISH</span><h2>Yangi foydalanuvchi</h2><p>Vakolat → shaxsiy ma’lumot → tuzilma → kirish ma’lumotlari. Login va parolni tizimning o‘zi tavsiya qiladi.</p></div></div>
<div class="quick-note"><b>1 daqiqada tayyor.</b><span>Fakultet va kafedra yagona katalogdan tanlanadi; login va vaqtinchalik parol avtomatik generatsiya qilinadi.</span></div>
<div class="steps"><span class="active">1</span><i></i><span>2</span><i></i><span>3</span><i></i><span>4</span></div>
<form method="post" action="/users" id="wizardForm">
<div class="wizard-step active" data-step="1"><h3>1. Vakolatni tanlang</h3><div class="role-grid"><% allowedRoles.forEach(r=>{ %><label class="role-card"><input type="radio" name="role" value="<%= r %>" required><span><b><%= roleLabels[r] %></b><small><%= r %></small></span></label><% }) %></div><div class="wizard-actions"><span></span><button type="button" class="primary next">Davom etish →</button></div></div>
<div class="wizard-step" data-step="2"><h3>2. Shaxsiy ma’lumotlar</h3><div class="form-grid"><label>F.I.Sh.<input id="fullNameInput" name="fullName" required placeholder="Familiya Ism Sharif"></label><label>Xodim / ID raqami<input name="employeeId" placeholder="Masalan: 01234"></label><label>Telefon<input name="phone" inputmode="tel" placeholder="+998 90 123 45 67"></label><label>E-mail<input type="email" name="email" placeholder="user@kstu.uz"></label></div><div class="wizard-actions"><button type="button" class="ghost prev">← Orqaga</button><button type="button" class="primary next">Davom etish →</button></div></div>
<div class="wizard-step" data-step="3"><h3>3. Akademik tuzilma</h3><div class="academic-cascade form-grid"><label>Fakultet<select name="faculty" data-academic="faculty"><option value="">Tanlang</option><% [...new Set(structures.map(x=>x.faculty))].forEach(x=>{ %><option><%= x %></option><% }) %></select></label><label>Kafedra<select name="department" data-academic="department"><option value="">Avval fakultetni tanlang</option></select></label><select data-academic="specialty" hidden><option></option></select><select data-academic="group" hidden><option></option></select></div><small class="field-help">Nomlar faqat yagona akademik katalogdan keladi.</small><div class="wizard-actions"><button type="button" class="ghost prev">← Orqaga</button><button type="button" class="primary next">Davom etish →</button></div></div>
<div class="wizard-step" data-step="4"><h3>4. Kirish ma’lumotlari</h3>
  <div class="form-grid one">
    <label>Login
      <div class="input-shell"><input id="loginInput" name="login" required autocomplete="off" placeholder="familiya.ism"><button type="button" class="tiny-btn" id="makeLogin">Yaratish</button></div>
      <small>F.I.Sh. asosida avtomatik login yaratish mumkin.</small>
    </label>
    <label>Vaqtinchalik parol
      <div class="input-shell"><input id="passwordInput" type="text" name="password" minlength="8" required autocomplete="new-password"><button type="button" class="tiny-btn" id="makePassword">Yaratish</button><button type="button" class="tiny-btn" id="copyPassword">Nusxa</button></div>
      <small>Foydalanuvchi birinchi kirishda o‘zgartiradi.</small>
    </label>
  </div>
  <div class="secure-note">🔐 Hisob yaratilgach login va vaqtinchalik parolni foydalanuvchiga yuboring. Birinchi kirishda yangi parol talab qilinadi.</div>
  <div class="wizard-actions"><button type="button" class="ghost prev">← Orqaga</button><button class="primary">Hisobni yaratish</button></div>
</div>
</form></section>
<script type="application/json" id="academicStructureData"><%- JSON.stringify(structures).replace(/</g,'\\u003c') %></script>
<script>
(() => {
  const full=document.getElementById('fullNameInput');
  const login=document.getElementById('loginInput');
  const pass=document.getElementById('passwordInput');
  const translit=s=>String(s||'').toLowerCase()
    .replace(/[ʻ’']/g,'').replace(/sh/g,'sh').replace(/ch/g,'ch')
    .replace(/o‘|oʻ/g,'o').replace(/g‘|gʻ/g,'g')
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/[^a-z0-9 ]/g,' ').trim().replace(/\s+/g,' ');
  const makeLogin=()=>{
    const p=translit(full.value).split(' ').filter(Boolean);
    login.value=p.length>1 ? (p[0]+'.'+p[1]).slice(0,40) : (p[0]||'user');
  };
  const makePassword=()=>{
    const chars='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#';
    const arr=new Uint32Array(12); crypto.getRandomValues(arr);
    pass.value=Array.from(arr,n=>chars[n%chars.length]).join('');
  };
  document.getElementById('makeLogin')?.addEventListener('click',makeLogin);
  document.getElementById('makePassword')?.addEventListener('click',makePassword);
  document.getElementById('copyPassword')?.addEventListener('click',async()=>{if(!pass.value)makePassword();await navigator.clipboard?.writeText(pass.value);});
  full?.addEventListener('blur',()=>{if(!login.value)makeLogin();});
})();
</script>
</main></div><%- include('../partials/foot') %>
