<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content narrow">
<%- include('../partials/flash') %>
<section class="panel wizard-panel"><div class="panel-head"><div><span class="eyebrow">ZINAPOYA USULI</span><h2>Yangi hisob yaratish</h2><p>Vakolat → shaxsiy ma’lumot → katalogdan fakultet/kafedra → login/parol.</p></div></div>
<div class="quick-note"><b>Nomlar qo‘lda yozilmaydi.</b><span>Fakultet va kafedra administrator yaratgan akademik katalogdan tanlanadi.</span></div>
<div class="steps"><span class="active">1</span><i></i><span>2</span><i></i><span>3</span><i></i><span>4</span></div>
<form method="post" action="/users" id="wizardForm">
<div class="wizard-step active" data-step="1"><h3>1. Vakolatni tanlang</h3><div class="role-grid"><% allowedRoles.forEach(r=>{ %><label class="role-card"><input type="radio" name="role" value="<%= r %>" required><span><b><%= roleLabels[r] %></b><small><%= r %></small></span></label><% }) %></div><div class="wizard-actions"><span></span><button type="button" class="primary next">Davom etish →</button></div></div>
<div class="wizard-step" data-step="2"><h3>2. Shaxsiy ma’lumotlar</h3><div class="form-grid"><label>F.I.Sh.<input name="fullName" required></label><label>Xodim / ID raqami<input name="employeeId"></label><label>Telefon<input name="phone"></label><label>E-mail<input type="email" name="email"></label></div><div class="wizard-actions"><button type="button" class="ghost prev">← Orqaga</button><button type="button" class="primary next">Davom etish →</button></div></div>
<div class="wizard-step" data-step="3"><h3>3. Universitet strukturasi</h3><div class="academic-cascade form-grid"><label>Fakultet<select name="faculty" data-academic="faculty"><option value="">Tanlang</option><% [...new Set(structures.map(x=>x.faculty))].forEach(x=>{ %><option><%= x %></option><% }) %></select></label><label>Kafedra<select name="department" data-academic="department"><option value="">Avval fakultetni tanlang</option></select></label><select data-academic="specialty" hidden><option></option></select><select data-academic="group" hidden><option></option></select></div><small class="field-help">Texnik/dekan/kafedra xodimlari yangi fakultet nomini o‘ylab yozmaydi — nomlar faqat master katalogdan keladi.</small><div class="wizard-actions"><button type="button" class="ghost prev">← Orqaga</button><button type="button" class="primary next">Davom etish →</button></div></div>
<div class="wizard-step" data-step="4"><h3>4. Kirish ma’lumotlari</h3><div class="form-grid one"><label>Login<input name="login" required autocomplete="off" placeholder="familya.ism"></label><label>Vaqtinchalik parol<input type="password" name="password" minlength="8" required autocomplete="new-password"><small>Foydalanuvchi birinchi kirishda o‘zgartiradi.</small></label></div><div class="secure-note">🔐 Public register yo‘q. Superadmin/rahbariyat credentiallari texnik paneldan himoyalangan.</div><div class="wizard-actions"><button type="button" class="ghost prev">← Orqaga</button><button class="primary">Hisobni yaratish</button></div></div>
</form></section>
<script type="application/json" id="academicStructureData"><%- JSON.stringify(structures).replace(/</g,'\\u003c') %></script>
</main></div><%- include('../partials/foot') %>
