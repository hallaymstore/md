<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content">
<section class="hero-line intelligence-hero"><div><span class="eyebrow">DISSERTATSIYA JARAYONI</span><h1>Dissertatsiyaning 12 bosqichli bajarilish rejasi</h1><p>Mavzu tanlashdan yakuniy himoyagacha — muddat, status, foiz, izoh va dalil havolasi bilan.</p></div></section>
<% if(currentUser.role!=='student'){ %><section class="panel milestone-selector"><form method="get"><label>Magistrant<select name="student" onchange="this.form.submit()"><% students.forEach(s=>{ %><option value="<%= s._id %>" <%= selected&&String(selected._id)===String(s._id)?'selected':'' %>><%= s.fullName %> — <%= s.group||'—' %></option><% }) %></select></label></form></section><% } %>
<% if(selected){ %><section class="student-pulse"><div><span>MAGISTRANT</span><b><%= selected.fullName %></b><small><%= selected.group||'—' %> · <%= selected.specialty||'—' %></small></div><div><span>JORIY BOSQICH</span><b><%= selected.dissertationStage %>/12</b></div><div><span>UMUMIY BAJARILISH</span><b><%= selected.dissertationProgress %>%</b></div><div><span>RAHBAR</span><b><%= selected.supervisor?.fullName||'Biriktirilmagan' %></b></div></section>
<section class="milestone-grid"><% timeline.forEach(item=>{ const r=item.record; const status=r?.status||'not_started'; %><article class="milestone-card <%= status %>"><header><span class="milestone-no"><%= item.stage %></span><div><b><%= item.title %></b><small><%= status==='approved'?'Tasdiqlangan':status==='submitted'?'Tekshiruvga yuborilgan':status==='in_progress'?'Jarayonda':status==='delayed'?'Kechikmoqda':'Boshlanmagan' %></small></div><strong><%= r?.percent||0 %>%</strong></header><div class="mini-progress"><i style="width:<%= r?.percent||0 %>%"></i></div><div class="milestone-meta"><span>Muddat: <b><%= r?.dueDate?new Date(r.dueDate).toLocaleDateString('uz-UZ'):'—' %></b></span><% if(r?.evidenceLink){ %><a href="<%= r.evidenceLink %>" target="_blank" rel="noopener">Dalil ↗</a><% } %></div><% if(r?.note){ %><p><%= r.note %></p><% } %><% if(['superadmin','tech','magistracy','dean','department','supervisor'].includes(currentUser.role)){ %><details><summary>Bosqichni yangilash</summary><form method="post" action="/milestones/<%= selected._id %>/<%= item.stage %>" class="milestone-form"><label>Status<select name="status"><% [['not_started','Boshlanmagan'],['in_progress','Jarayonda'],['submitted','Yuborildi'],['approved','Tasdiqlandi'],['delayed','Kechikmoqda']].forEach(o=>{ %><option value="<%= o[0] %>" <%= status===o[0]?'selected':'' %>><%= o[1] %></option><% }) %></select></label><label>Foiz<input name="percent" type="number" min="0" max="100" value="<%= r?.percent||0 %>"></label><label>Muddat<input name="dueDate" type="date" value="<%= r?.dueDate?new Date(r.dueDate).toISOString().slice(0,10):'' %>"></label><label>Dalil havolasi<input name="evidenceLink" value="<%= r?.evidenceLink||'' %>"></label><label class="wide">Izoh<textarea name="note"><%= r?.note||'' %></textarea></label><button class="primary">Saqlash</button></form></details><% } %></article><% }) %></section><% }else{ %><section class="panel empty">Magistrant topilmadi.</section><% } %>
</main></div><%- include('../partials/foot') %>
