<%- include('../partials/head') %>
<main class="login-shell light-auth-v21"><button class="auth-theme-toggle theme-toggle" type="button" data-theme-toggle title="Kunduzgi / tungi mavzu"><span class="theme-icon">☾</span><span class="theme-label">Tungi</span></button>
  <section class="login-info login-intro">
    <div class="login-brand-row">
      <div class="university-mark"><span>MD</span></div>
      <div><b>MD</b><small>Magistratura boshqaruv tizimi</small></div>
      <span class="version-badge">MD 3.4 • OSON KIRISH</span>
    </div>
    <div class="login-copy">
      <span class="eyebrow">MD • MAGISTRATURA BOSHQARUVI</span>
      <h1>MD<br><span>magistratura boshqaruv markazi</span></h1>
      <p>Rahbariyatdan magistrantgacha — alohida vakolat, jonli nazorat, ilmiy jarayon va muddatlar yagona muhitda.</p>
      <div class="login-feature-grid">
        <div><i>01</i><b>Oson kirish</b><span>Login, telefon, e-mail yoki ID bilan</span></div>
        <div><i>02</i><b>Erta ogohlantirish</b><span>Muammoli holatni oldindan ko‘rish</span></div>
        <div><i>03</i><b>12 bosqich</b><span>Dissertatsiyani bosqichma-bosqich kuzatish</span></div>
        <div><i>04</i><b>PWA va offline</b><span>Telefon va kompyuterda ilova sifatida</span></div>
      </div>
    </div>
    <div class="secure-line"><span>●</span> Ochiq ro‘yxatdan o‘tish yo‘q • hisobni vakolatli xodim beradi</div>
    <button class="secondary md-install-login" type="button" data-pwa-install hidden>⬇ MD ilovasini o‘rnatish</button>
  </section>

  <section class="login-side">
    <div class="login-card light-login-card">
      <div class="login-card-top"><div class="login-logo">MD</div><span class="internal-chip">ICHKI TIZIM</span></div>
      <span class="eyebrow">TEZ VA XAVFSIZ KIRISH</span>
      <h2>Tizimga kirish</h2>
      <p>Login, telefon raqam, e-mail yoki xodim/talaba ID raqamingizni kiriting.</p>
      <%- include('../partials/flash') %>
      <form method="post" action="/login" class="stack login-form-v21" id="loginForm">
        <label><span>LOGIN / TELEFON / E-MAIL / ID</span><div class="input-shell"><i>👤</i><input name="identifier" autocomplete="username" required autofocus placeholder="masalan: texnik01 yoki +998901234567"></div></label>
        <label><span>PAROL</span><div class="input-shell"><i>⌁</i><input id="loginPassword" type="password" name="password" autocomplete="current-password" required placeholder="••••••••"><button type="button" class="tiny-btn" id="showPassword" aria-label="Parolni ko‘rsatish">Ko‘rsat</button></div></label>
        <label style="display:flex;align-items:center;gap:10px"><input type="checkbox" name="remember" value="1" style="width:auto"><span>Shu qurilmada 30 kun eslab qolish</span></label>
        <button class="primary xl login-submit">Kirish <span>→</span></button>
      </form>
      <div class="login-security"><span>✓</span><div><b>Hisobingizni topish osonroq</b><small>Login esdan chiqsa, tizimga biriktirilgan telefon, e-mail yoki ID raqamdan foydalaning.</small></div></div>
      <footer>MD • Magistratura boshqaruvi</footer>
    </div>
  </section>
</main>
<script>
(() => {
  const input=document.getElementById('loginPassword');
  const btn=document.getElementById('showPassword');
  if(btn&&input) btn.addEventListener('click',()=>{const show=input.type==='password';input.type=show?'text':'password';btn.textContent=show?'Yashir':'Ko‘rsat';});
})();
</script>
<%- include('../partials/foot') %>
