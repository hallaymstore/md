<%- include('../partials/head') %>
<main class="login-shell light-auth-v21"><button class="auth-theme-toggle theme-toggle" type="button" data-theme-toggle title="Kunduzgi / tungi mavzu"><span class="theme-icon">☾</span><span class="theme-label">Tungi</span></button>
  <section class="login-info login-intro">
    <div class="login-brand-row">
      <div class="university-mark"><span>MD</span></div>
      <div><b>MD</b><small>Magistratura boshqaruv tizimi</small></div>
      <span class="version-badge">MAGISTRATURA BOSHQARUV TIZIMI</span>
    </div>
    <div class="login-copy">
      <span class="eyebrow">MD • MAGISTRATURA BOSHQARUVI</span>
      <h1>MD<br><span>magistratura boshqaruv markazi</span></h1>
      <p>Rahbariyatdan magistrantgacha — alohida vakolat, jonli nazorat, ilmiy jarayon va muddatlar yagona muhitda.</p>
      <div class="login-feature-grid">
        <div><i>01</i><b>Erta ogohlantirish</b><span>Muammoli holatni oldindan ko‘rish</span></div>
        <div><i>02</i><b>Muammo va chora</b><span>Mas’ul, muddat va natijagacha nazorat</span></div>
        <div><i>03</i><b>12 bosqich</b><span>Dissertatsiyani bosqichma-bosqich kuzatish</span></div>
        <div><i>04</i><b>PWA va offline</b><span>MDni ilova sifatida o‘rnatish va uzilishda davom etish</span></div>
      </div>
    </div>
    <div class="secure-line"><span>●</span> Ochiq ro‘yxatdan o‘tish mavjud emas • hisoblar vakolat zanjiri orqali beriladi</div><button class="secondary md-install-login" type="button" data-pwa-install hidden>⬇ MD ilovasini o‘rnatish</button>
  </section>

  <section class="login-side">
    <div class="login-card light-login-card">
      <div class="login-card-top"><div class="login-logo">MD</div><span class="internal-chip">ICHKI TIZIM</span></div>
      <span class="eyebrow">XAVFSIZ KIRISH</span>
      <h2>Tizimga kirish</h2>
      <p>Vakolatli xodim tomonidan berilgan foydalanuvchi nomi va paroldan foydalaning.</p>
      <%- include('../partials/flash') %>
      <form method="post" action="/login" class="stack login-form-v21">
        <label><span>FOYDALANUVCHI NOMI</span><div class="input-shell"><i>👤</i><input name="login" autocomplete="username" required placeholder="masalan: texnik01"></div></label>
        <label><span>PAROL</span><div class="input-shell"><i>⌁</i><input type="password" name="password" autocomplete="current-password" required placeholder="••••••••"></div></label>
        <button class="primary xl login-submit">Kirish <span>→</span></button>
      </form>
      <div class="login-security"><span>✓</span><div><b>Himoyalangan MD tizimi</b><small>Ro‘yxatdan o‘tish faqat vakolatli xodim orqali amalga oshiriladi. Muhim o‘zgarishlar faoliyat tarixida qayd etiladi.</small></div></div>
      <footer>MD • Magistratura boshqaruvi</footer>
    </div>
  </section>
</main>
<%- include('../partials/foot') %>
