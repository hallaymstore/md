    <a class="<%= path.startsWith('/md/trends')?'active':'' %>" href="/md/trends"><i>⌁</i><span>O‘zgarishlar dinamikasi</span></a>
    <a class="<%= path.startsWith('/md/advantages')?'active':'' %>" href="/md/advantages"><i>i</i><span>MD imkoniyatlari</span></a>
