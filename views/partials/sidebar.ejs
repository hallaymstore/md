    <% if(['superadmin','tech','magistracy','dean','department'].includes(currentUser.role)){ %><a class="<%= path.startsWith('/users')?'active':'' %>" href="/users"><i>◇</i><span>Hisoblar va vakolat</span></a><% } %>
