<%- include('../partials/head') %><%- include('../partials/sidebar') %><div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="hero-line"><div><span class="eyebrow">ICHKI BILDIRISHNOMALAR</span><h1>Bildirishnomalar</h1><p>Yangi ariza, bosqich qarori, tuzatish so‘rovi va sharhlar shu yerda jamlanadi.</p></div><form method="post" action="/notifications/read-all"><button class="secondary">Barchasini o‘qilgan qilish</button></form></section>
<section class="panel notification-center"><div class="notification-list"><% notifications.forEach(item=>{ %><form method="post" action="/notifications/<%= item._id %>/read" class="notification-item <%= item.readAt?'read':'unread' %>"><button><i><%= item.type==='decision'?'✓':item.type==='comment'?'✎':item.type==='system'?'⚙':'⇢' %></i><div><span><%= item.readAt?'O‘qilgan':'Yangi' %> · <%= new Date(item.createdAt).toLocaleString('uz-UZ') %></span><b><%= item.title %></b><p><%= item.message %></p><small><%= item.createdBy?.fullName||'Tizim' %></small></div><strong>Ochish →</strong></button></form><% }) %><% if(!notifications.length){ %><div class="empty-state large"><b>Bildirishnoma yo‘q</b><span>Yangi qaror yoki ariza kelganda shu yerda ko‘rinadi.</span></div><% } %></div></section>
</main></div><%- include('../partials/foot') %>
