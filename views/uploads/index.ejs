<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content">
<%- include('../partials/flash') %>
<section class="hero-line compact"><div><span class="eyebrow">MATERIALLAR MARKAZI</span><h1>Materiallar va hujjatlar</h1><p>Ilmiy ishlar, hujjatlar, hisobotlar, taqdimotlar va boshqa materiallarni bir joyda saqlash.</p></div><div class="hero-actions"><a class="secondary" href="/submissions">Ilmiy arizalar</a><% if(currentUser.role==='student'){ %><a class="primary" href="/submissions/new">+ Ariza bilan yuborish</a><% } %></div></section>
<% if(currentUser.role==='student'){ %><section class="privacy-note"><b>Ilmiy ish yuboryapsizmi?</b><span>Ilmiy rahbar, kafedra va yuqori bosqichlardan rasmiy tasdiq olish uchun oddiy fayl yuklash emas, “Ariza bilan yuborish”dan foydalaning.</span></section><% } %>
<section class="grid-2 upload-layout"><article class="panel upload-card"><div class="panel-head"><div><span class="eyebrow">YUKLASH</span><h2>Yangi fayl</h2></div></div><form method="post" action="/uploads" enctype="multipart/form-data" class="form-grid one"><label class="dropzone"><input type="file" name="file" required><strong>⇧ Faylni tanlang</strong><span>20 MB gacha • material / hujjat / hisobot / seminar</span></label><label>Kategoriya<select name="category"><option value="source">Material</option><option value="document">Hujjat</option><option value="seminar">Seminar</option><option value="report">Hisobot</option><option value="publication">Ilmiy maqola</option><option value="conference">Konferensiya</option><option value="attestation">Attestatsiya</option><option value="defense">Himoya hujjati</option><option value="protocol">Bayonnoma</option><option value="thesis">Dissertatsiya / tezis</option><option value="other">Boshqa</option></select></label><label>Magistrantga bog‘lash<select name="student"><option value="">Umumiy fayl</option><% students.forEach(s=>{ %><option value="<%= s._id %>"><%= s.fullName %> — <%= s.group || '—' %></option><% }) %></select></label><label>Tavsif<textarea name="description" placeholder="Fayl nimaga tegishli..."></textarea></label><button class="primary">Faylni yuklash</button></form></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">QOIDALAR</span><h2>Ichki fayl markazi</h2></div></div><div class="feature-list"><div><i>01</i><p><b>Markaziy saqlash</b><span>Bo‘limlar alohida kompyuter yoki messenjerlarda fayl saqlamaydi.</span></p></div><div><i>02</i><p><b>Faoliyat qaydi</b><span>Kim, qachon va qaysi kategoriyada yuklagani qayd etiladi.</span></p></div><div><i>03</i><p><b>Magistrant bilan bog‘lash</b><span>Dissertatsiya, seminar, maqola va hisobot fayllari profilga biriktiriladi.</span></p></div><div><i>04</i><p><b>Xavfsiz saqlash</b><span>Yuklangan materiallar markaziy tartibda saqlanadi va mas’ul foydalanuvchi bilan bog‘lanadi.</span></p></div></div></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">MATERIALLAR RO‘YXATI</span><h2>Yuklangan materiallar</h2></div></div><div class="file-grid"><% uploads.forEach(f=>{ %><a class="file-card" href="<%= f.path %>" target="_blank"><div class="file-icon">⌑</div><div><b><%= f.originalName %></b><span><%= f.category %> · <%= (f.size/1024/1024).toFixed(2) %> MB</span><small><%= f.student?.fullName || 'Umumiy' %> · <%= f.uploadedBy?.fullName || '—' %></small></div></a><% }) %><% if (!uploads.length) { %><div class="empty">Hali fayl yuklanmagan.</div><% } %></div></section>
</main></div><%- include('../partials/foot') %>
