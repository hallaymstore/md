<% if(typeof submissionStats!=='undefined' && currentUser.role!=='teacher'){ const pendingLabel=currentUser.role==='student'?'Tuzatish kerak':currentUser.role==='tech'?'Jarayondagi ariza':currentUser.role==='superadmin'?'Nazorat / qaror':'Sizning navbatingiz'; %><section class="panel dashboard-submissions"><div class="panel-head"><div><span class="eyebrow">ILMIY ARIZALAR HOLATI</span><h2><%= currentUser.role==='student'?'Arizalarim holati':'Tasdiqlash navbati' %></h2></div><a href="/submissions">Barchasi →</a></div><div class="submission-dashboard-grid"><div class="submission-dash-stats"><a href="/submissions"><span>Jami</span><b><%= submissionStats.total %></b></a><a class="attention" href="/submissions?status=<%= currentUser.role==='student'?'changes_requested':'under_review' %>"><span><%= pendingLabel %></span><b><%= submissionStats.pending %></b></a><a href="/submissions?status=approved"><span>Tasdiqlangan</span><b><%= submissionStats.approved %></b></a><a href="/submissions?status=under_review"><span>Jarayonda</span><b><%= submissionStats.reviewing %></b></a></div><div class="submission-dash-list"><% submissionRecent.slice(0,5).forEach(item=>{ %><a href="/submissions/<%= item._id %>"><div><span><%= item.applicationNo %> · <%= submissionTypeLabels[item.type]||item.type %></span><b><%= item.title %></b><small><%= item.student?.fullName||'—' %></small></div><em class="status <%= submissionStatusTones[item.status]||'muted' %>"><%= submissionStatusLabels[item.status]||item.status %></em></a><% }) %><% if(!submissionRecent.length){ %><div class="empty">Hali ilmiy ariza yo‘q.</div><% } %></div></div></section><% } %>
