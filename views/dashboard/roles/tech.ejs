<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">MA’LUMOTLAR SIFATI</span><h2>Tez tuzatiladigan holatlar</h2></div><a href="/control">To‘liq nazorat →</a></div><div class="overview-grid"><div><span>Davomat</span><b><%= kpis.attendance %>%</b></div><div><span>Reja</span><b><%= kpis.plan %>%</b></div><div><span>Dissertatsiya</span><b><%= kpis.dissertation %>%</b></div><div><span>Profil</span><b><%= kpis.profileCompleteness %>%</b></div></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">TEZKOR ISHLAR</span><h2>Tezkor boshqaruv</h2></div></div><div class="control-links"><a href="/timetable/import"><b>Excel orqali dars jadvali yuklash</b><small>Shablon → preview → konflikt tekshiruvi → tasdiqlash</small></a><a href="/timetable">Haftalik dars jadvalini boshqarish</a><a href="/students/quick">10+ talabani birdan kiritish</a><a href="/users">Hisob profillarini boshqarish</a><a href="/uploads">Materiallar markazi</a><a href="/monitoring">Monitoring yozuvlari</a><a href="/structure">Akademik katalogni ko‘rish</a><a href="/audit">Faoliyat tarixi</a></div></article></section>
