<section class="hero-line role-hero role-hero-management"><div><span class="eyebrow">RAHBARIYAT UCHUN</span><h1>Magistratura holati</h1><p>Rahbariyat uchun yakuniy ilmiy tasdiqlar va qaror qabul qilishga yo‘naltirilgan ko‘rsatkichlar.</p></div><div class="hero-actions"><a class="secondary" href="/analytics">To‘liq analitika</a><a class="primary" href="/submissions">Yakuniy arizalar →</a></div></section>
<section class="kpi-grid"><article class="kpi"><span>JAMI MAGISTRANT</span><strong><%= kpis.total %></strong><small>1-kurs <b><%= kpis.course1 %></b> · 2-kurs <b><%= kpis.course2 %></b></small></article><article class="kpi"><span>MUTAXASSISLIK</span><strong><%= kpis.specialties %></strong><small>Ilmiy rahbar: <b><%= kpis.supervisors %></b></small></article><article class="kpi"><span>DAVOMAT</span><strong><%= kpis.attendance %>%</strong><div class="mini-progress"><i style="width:<%= kpis.attendance %>%"></i></div></article><article class="kpi"><span>DISSERTATSIYA</span><strong><%= kpis.dissertation %>%</strong><div class="mini-progress"><i style="width:<%= kpis.dissertation %>%"></i></div></article><article class="kpi"><span>BITIRUV TAYYORLIGI</span><strong><%= kpis.readiness %>%</strong><div class="mini-progress"><i style="width:<%= kpis.readiness %>%"></i></div></article><article class="kpi"><span>MUAMMOLI</span><strong><%= kpis.problemStudents %></strong><small>kechikkan topshiriq: <b><%= kpis.overdueTasks %></b></small></article></section>
<section class="grid-3"><article class="panel"><div class="panel-head"><div><span class="eyebrow">HOLAT TAQSIMOTI</span><h2>Umumiy holat</h2></div></div><div class="donut" style="--green:<%= percentages.green %>;--yellow:<%= percentages.yellow %>"><div><strong><%= percentages.green %>%</strong><span>talab darajasida</span></div></div><div class="legend"><span><i class="dot green"></i>Yashil <b><%= status.green %></b></span><span><i class="dot yellow"></i>Nazorat <b><%= status.yellow %></b></span><span><i class="dot red"></i>Muammo <b><%= status.red %></b></span></div></article><article class="panel span-2"><div class="panel-head"><div><span class="eyebrow">FAKULTET TAQQOSLASH</span><h2>Asosiy indikatorlar</h2></div></div><div class="compare-list"><% facultyStats.slice(0,10).forEach(x=>{ %><div><b><%= x.name %></b><span><i style="width:<%= x.dissertation %>%"></i></span><em><%= x.dissertation %>% diss. · <%= x.attendance %>% dav. · <%= x.red %> muammo</em></div><% }) %></div></article></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">DISSERTATSIYA</span><h2>Bajarilish taqsimoti</h2></div></div><div class="bucket-grid"><div><b><%= dissertationBuckets.complete %></b><span>100%</span></div><div><b><%= dissertationBuckets.high %></b><span>75–99%</span></div><div><b><%= dissertationBuckets.medium %></b><span>50–74%</span></div><div class="risk"><b><%= dissertationBuckets.low %></b><span>50% dan kam</span></div></div></article><article class="panel danger-panel"><div class="panel-head"><div><span class="eyebrow">DIQQAT TALAB QILADI</span><h2>Muammolar</h2></div><a href="/tasks">Topshiriqlar →</a></div><div class="alert-list"><% problems.slice(0,8).forEach(s=>{ %><a href="/students/<%= s._id %>"><i class="dot red"></i><div><b><%= s.fullName %></b><span><%= s.faculty||'—' %> · davomat <%= s.attendance %>% · dissertatsiya <%= s.dissertationProgress %>%</span></div><strong>→</strong></a><% }) %></div></article></section>
