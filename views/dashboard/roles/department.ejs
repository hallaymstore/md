<section class="hero-line role-hero role-hero-department"><div><span class="eyebrow">KAFEDRA BOSHQARUVI</span><h1><%= currentUser.department || 'Kafedra' %></h1><p>Magistrantlar, ilmiy rahbarlar, hujjatlar va ilmiy arizalarning kundalik nazorati.</p></div><div class="hero-actions"><a class="secondary" href="/tasks">Topshiriqlar</a><a class="primary" href="/submissions">Kafedra arizalari →</a></div></section>
<section class="kpi-grid"><article class="kpi"><span>MAGISTRANT</span><strong><%= kpis.total %></strong></article><article class="kpi"><span>RAHBAR</span><strong><%= kpis.supervisors %></strong></article><article class="kpi"><span>DISSERTATSIYA</span><strong><%= kpis.dissertation %>%</strong></article><article class="kpi"><span>ILMIY FAOLLIK</span><strong><%= kpis.science %>%</strong></article><article class="kpi"><span>YO‘Q HUJJAT</span><strong><%= kpis.missingDocs %></strong></article><article class="kpi"><span>OCHIQ TOPSHIRIQ</span><strong><%= kpis.openTasks %></strong></article></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">RAHBARLAR</span><h2>Ilmiy rahbarlar monitoringi</h2></div></div><div class="metric-list"><% supervisorStats.forEach(x=>{ %><div class="metric-row"><div><b><%= x.name %></b><span><%= x.total %> magistrant · <%= x.red %> muammoli</span></div><div class="metric-bars"><em><i style="width:<%= x.dissertation %>%"></i></em><strong><%= x.dissertation %>%</strong></div></div><% }) %></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">ILMIY FAOLIYAT</span><h2>Natijalar</h2></div><a href="/science">Ochish →</a></div><div class="overview-grid"><div><span>Maqolalar</span><b><%= scienceStats.publications %></b></div><div><span>Konferensiya</span><b><%= scienceStats.conferences %></b></div><div><span>Tadqiqot</span><b><%= scienceStats.research %></b></div><div><span>Seminar</span><b><%= scienceStats.seminars %></b></div></div></article></section>
<section class="panel danger-panel"><div class="panel-head"><div><span class="eyebrow">KAFEDRA NAZORATI</span><h2>Muammoli magistrantlar</h2></div><span class="badge red"><%= problems.length %></span></div><div class="table-wrap"><table><thead><tr><th>Magistrant</th><th>Guruh</th><th>Davomat</th><th>Reja</th><th>Dissertatsiya</th><th>Hujjat</th><th></th></tr></thead><tbody><% problems.slice(0,15).forEach(s=>{ %><tr><td><b><%= s.fullName %></b></td><td><%= s.group||'—' %></td><td><%= s.attendance %>%</td><td><%= s.individualPlan %>%</td><td><%= s.dissertationProgress %>%</td><td><%= s.documentsCompleteness %>%</td><td><a class="table-link" href="/students/<%= s._id %>">Profil →</a></td></tr><% }) %></tbody></table></div></section>
