<section class="hero-line role-hero role-hero-dean"><div><span class="eyebrow">FAKULTET DASHBOARDI</span><h1><%= currentUser.faculty || 'Fakultet' %></h1><p>Faqat fakultetingizga tegishli magistrantlar, kafedralar va monitoring indikatorlari.</p></div><div class="hero-actions"><a class="secondary" href="/analytics">Analitika</a><a class="primary" href="/submissions?stage=dean&status=in_review">Dekanat arizalari <%= submissionStats.pending?"("+submissionStats.pending+")":"" %></a></div></section>
<section class="kpi-grid"><article class="kpi"><span>MAGISTRANT</span><strong><%= kpis.total %></strong><small><%= kpis.specialties %> mutaxassislik</small></article><article class="kpi"><span>DAVOMAT</span><strong><%= kpis.attendance %>%</strong></article><article class="kpi"><span>REJA</span><strong><%= kpis.plan %>%</strong></article><article class="kpi"><span>DISSERTATSIYA</span><strong><%= kpis.dissertation %>%</strong></article><article class="kpi"><span>HUJJATLAR</span><strong><%= kpis.documents %>%</strong></article><article class="kpi"><span>MUAMMOLI</span><strong><%= kpis.problemStudents %></strong></article></section>
<section class="panel review-queue-card"><div class="panel-head"><div><span class="eyebrow">FAKULTET TASDIG‘I</span><h2><%= submissionStats.pending %> ta ilmiy ariza dekanat bosqichida</h2></div><a href="/submissions?stage=dean&status=in_review" class="primary">Ko‘rib chiqish →</a></div><div class="bucket-grid"><div><b><%= submissionStats.department %></b><span>Kafedrada</span></div><div><b><%= submissionStats.dean %></b><span>Dekanatda</span></div><div><b><%= submissionStats.magistracy %></b><span>Magistraturada</span></div><div><b><%= submissionStats.approved %></b><span>Ma’qullangan</span></div></div></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">KAFEDRALAR</span><h2>Taqqoslama monitoring</h2></div></div><div class="metric-list"><% departmentStats.forEach(x=>{ %><div class="metric-row"><div><b><%= x.name %></b><span><%= x.total %> magistrant · <%= x.red %> muammoli</span></div><div class="metric-bars"><em><i style="width:<%= x.dissertation %>%"></i></em><strong><%= x.dissertation %>%</strong></div></div><% }) %></div></article><article class="panel danger-panel"><div class="panel-head"><div><span class="eyebrow">FAKULTET RISKLARI</span><h2>Nazorat talab qiladi</h2></div></div><div class="alert-list"><% problems.slice(0,10).forEach(s=>{ %><a href="/students/<%= s._id %>"><i class="dot red"></i><div><b><%= s.fullName %></b><span><%= s.department||'—' %> · <%= s.group||'—' %></span></div><strong>→</strong></a><% }) %></div></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">ILMIY RAHBARLAR</span><h2>Yuklama va natija</h2></div><a href="/analytics">Batafsil →</a></div><div class="table-wrap"><table><thead><tr><th>Rahbar</th><th>Magistrant</th><th>Davomat</th><th>Reja</th><th>Dissertatsiya</th><th>Muammoli</th></tr></thead><tbody><% supervisorStats.forEach(x=>{ %><tr><td><b><%= x.name %></b></td><td><%= x.total %></td><td><%= x.attendance %>%</td><td><%= x.plan %>%</td><td><%= x.dissertation %>%</td><td><span class="status <%= x.red?'red':'green' %>"><%= x.red %></span></td></tr><% }) %></tbody></table></div></section>
