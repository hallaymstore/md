<% const me=students[0]; %>
<section class="hero-line role-hero role-hero-student"><div><span class="eyebrow">MAGISTRANT SHAXSIY KABINETI</span><h1><%= me?.fullName || currentUser.fullName %></h1><p>Shaxsiy reja, dissertatsiya, ilmiy faoliyat, hujjatlar va muddatlar.</p></div><div class="hero-actions"><a class="secondary" href="/students/me/profile">Profilim <%= me ? (me.profileCompleteness||0)+'%' : '' %></a><a class="secondary" href="/submissions">Arizalarim <%= submissionStats.pending?"("+submissionStats.pending+")":"" %></a><a class="primary" href="/submissions/new">+ Ilmiy ariza</a></div></section>
<% if(me){ %><section class="student-hero panel"><div class="progress-ring" style="--p:<%= me.graduationReadiness %>"><div><strong><%= me.graduationReadiness %>%</strong><span>bitiruv tayyorligi</span></div></div><div class="student-main-info"><span class="eyebrow"><%= me.group||'—' %> • <%= me.specialty||'—' %></span><h2><%= me.dissertationTitle||'Dissertatsiya mavzusi kiritilmagan' %></h2><p>Ilmiy rahbar: <b><%= me.supervisor?.fullName||'Biriktirilmagan' %></b></p><div class="pill-row"><span>Davomat <b><%= me.attendance %>%</b></span><span>Reja <b><%= me.individualPlan %>%</b></span><span>Dissertatsiya <b><%= me.dissertationProgress %>%</b></span><span>Ilmiy faollik <b><%= me.scientificActivity %>%</b></span></div></div></section>
<section class="panel submission-dashboard-card"><div class="panel-head"><div><span class="eyebrow">ILMIY ARIZALAR</span><h2>Source va ilmiy ishlar tasdiqlash jarayoni</h2></div><a href="/submissions">Barchasi →</a></div><div class="overview-grid"><div><span>Jami</span><b><%= submissionStats.total %></b></div><div><span>Ko‘rib chiqilmoqda</span><b><%= submissionStats.inReview %></b></div><div><span>Tuzatish kerak</span><b><%= submissionStats.needsRevision %></b></div><div><span>Ma’qullangan</span><b><%= submissionStats.approved %></b></div></div><div class="form-actions"><a class="primary" href="/submissions/new">+ Yangi ilmiy ish / source yuborish</a></div></section>
<section class="grid-3"><article class="panel"><div class="panel-head"><div><span class="eyebrow">DISSERTATSIYA</span><h2><%= me.dissertationProgress %>% bajarildi</h2></div></div><div class="big-progress"><i style="width:<%= me.dissertationProgress %>%"></i></div><p class="muted">Joriy bosqich: <b><%= me.dissertationStage %>/12</b></p></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">HUJJATLAR</span><h2><%= me.documentsCompleteness %>% to‘liq</h2></div><a href="/documents">Ko‘rish →</a></div><div class="big-progress"><i style="width:<%= me.documentsCompleteness %>%"></i></div><p class="muted">Yetishmayotgan hujjatlar: <b><%= docStats.missing %></b></p></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">ILMIY PORTFEL</span><h2><%= science.length %> ta faoliyat</h2></div><a href="/science">Ko‘rish →</a></div><div class="overview-grid compact"><div><span>Maqola</span><b><%= scienceStats.publications %></b></div><div><span>Konferensiya</span><b><%= scienceStats.conferences %></b></div></div></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">MUDDATLAR</span><h2>Mening topshiriqlarim</h2></div></div><div class="timeline"><% openTasks.slice(0,10).forEach(t=>{ %><div><time><%= t.dueDate?new Date(t.dueDate).toLocaleDateString('uz-UZ'):'Muddat yo‘q' %></time><p><b><%= t.title %></b><span><%= t.description||t.type %></span></p><em class="priority <%= t.priority %>"><%= t.status %></em></div><% }) %><% if(!openTasks.length){ %><div class="empty">Ochiq topshiriq yo‘q.</div><% } %></div></section><% } else { %><section class="panel empty">Magistrant profilingiz hali hisobga bog‘lanmagan. Magistratura bo‘limiga murojaat qiling.</section><% } %>
