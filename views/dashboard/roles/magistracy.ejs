<section class="hero-line role-hero role-hero-magistracy"><div><span class="eyebrow">MAGISTRATURA BO‘LIMI • OPERATIONS</span><h1>Operatsion 360° nazorat</h1><p>Magistrant, rahbar, kafedra, dissertatsiya, seminar, hujjat, davomat va individual reja bir ekranda.</p></div><div class="hero-actions"><a class="secondary" href="/uploads">Source markazi</a><a class="primary" href="/submissions?stage=magistracy&status=in_review">Arizalar <%= submissionStats.pending?"("+submissionStats.pending+")":"" %></a></div></section>
<section class="kpi-grid dense"><article class="kpi"><span>MAGISTRANT</span><strong><%= kpis.total %></strong></article><article class="kpi"><span>DAVOMAT</span><strong><%= kpis.attendance %>%</strong></article><article class="kpi"><span>O‘ZLASHTIRISH</span><strong><%= kpis.academic %>%</strong></article><article class="kpi"><span>INDIVIDUAL REJA</span><strong><%= kpis.plan %>%</strong></article><article class="kpi"><span>DISSERTATSIYA</span><strong><%= kpis.dissertation %>%</strong></article><article class="kpi"><span>ILMIY FAOLLIK</span><strong><%= kpis.science %>%</strong></article><article class="kpi"><span>HUJJATLAR</span><strong><%= kpis.documents %>%</strong></article><article class="kpi"><span>AKAD. QARZ</span><strong><%= kpis.academicDebt %></strong></article><article class="kpi"><span>MAQOLA</span><strong><%= kpis.publications %></strong></article><article class="kpi"><span>KONFERENSIYA</span><strong><%= kpis.conferences %></strong></article><article class="kpi"><span>SEMINAR</span><strong><%= kpis.seminarsHeld %></strong></article><article class="kpi"><span>MUAMMOLI</span><strong><%= kpis.problemStudents %></strong></article></section>
<section class="panel review-queue-card"><div class="panel-head"><div><span class="eyebrow">MAGISTRATURA TASDIG‘I</span><h2><%= submissionStats.pending %> ta ariza bo‘lim qarorini kutmoqda</h2></div><a class="primary" href="/submissions?stage=magistracy&status=in_review">Navbat →</a></div><div class="overview-grid"><div><span>Jami ariza</span><b><%= submissionStats.total %></b></div><div><span>Jarayonda</span><b><%= submissionStats.inReview %></b></div><div><span>Tuzatishda</span><b><%= submissionStats.needsRevision %></b></div><div><span>Yakuniy ma’qullangan</span><b><%= submissionStats.approved %></b></div></div></section>
<section class="grid-3"><article class="panel"><div class="panel-head"><div><span class="eyebrow">DAVOMAT</span><h2>Holat</h2></div><a href="/monitoring">Nazorat →</a></div><div class="bucket-grid three"><div><b><%= attendanceBuckets.good %></b><span>90–100%</span></div><div><b><%= attendanceBuckets.watch %></b><span>75–89%</span></div><div class="risk"><b><%= attendanceBuckets.problem %></b><span>&lt;75%</span></div></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">HUJJATLAR</span><h2>Komplektlik</h2></div><a href="/documents">Ochish →</a></div><div class="bucket-grid three"><div><b><%= docStats.present %></b><span>Mavjud</span></div><div><b><%= docStats.update %></b><span>Yangilash</span></div><div class="risk"><b><%= docStats.missing %></b><span>Yo‘q</span></div></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">SEMINAR</span><h2>Ijro holati</h2></div><a href="/seminars">Ochish →</a></div><div class="bucket-grid three"><div><b><%= seminarStats.held %></b><span>O‘tkazildi</span></div><div><b><%= seminarStats.planned %></b><span>Rejada</span></div><div class="risk"><b><%= seminarStats.cancelled %></b><span>Bekor</span></div></div></article></section>
<section class="grid-2"><article class="panel danger-panel"><div class="panel-head"><div><span class="eyebrow">MUAMMOLAR PANELI</span><h2>Diqqat talab qiladiganlar</h2></div><span class="badge red"><%= problems.length %></span></div><div class="alert-list"><% problems.slice(0,12).forEach(s=>{ %><a href="/students/<%= s._id %>"><i class="dot red"></i><div><b><%= s.fullName %></b><span><%= s.group||'—' %> · dav. <%= s.attendance %>% · reja <%= s.individualPlan %>% · diss. <%= s.dissertationProgress %>% · hujjat <%= s.documentsCompleteness %>%</span></div><strong>→</strong></a><% }) %></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">30 KUNLIK NAZORAT</span><h2>Yaqin muddatlar</h2></div><a href="/tasks">Barchasi →</a></div><div class="timeline"><% upcomingTasks.slice(0,10).forEach(t=>{ %><div><time><%= new Date(t.dueDate).toLocaleDateString('uz-UZ') %></time><p><b><%= t.title %></b><span><%= t.student?.fullName||t.assignedTo?.fullName||'Umumiy' %></span></p><em class="priority <%= t.priority %>"><%= t.priority %></em></div><% }) %><% if(!upcomingTasks.length){ %><div class="empty">Yaqin muddatli topshiriq yo‘q.</div><% } %></div></article></section>
