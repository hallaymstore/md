<section class="hero-line role-hero role-hero-teacher"><div><span class="eyebrow">O‘QITUVCHI KABINETI</span><h1>O‘quv monitoringi</h1><p>O‘z kafedrangiz magistrantlarining davomat, o‘zlashtirish va topshiriqlarini kuzating.</p></div><div class="hero-actions"><a class="primary" href="/monitoring">Monitoring kiritish</a></div></section>
<section class="kpi-grid"><article class="kpi"><span>MAGISTRANT</span><strong><%= kpis.total %></strong></article><article class="kpi"><span>DAVOMAT</span><strong><%= kpis.attendance %>%</strong></article><article class="kpi"><span>O‘ZLASHTIRISH</span><strong><%= kpis.academic %>%</strong></article><article class="kpi"><span>AKAD. QARZ</span><strong><%= kpis.academicDebt %></strong></article><article class="kpi"><span>NAZORATDA</span><strong><%= status.yellow %></strong></article><article class="kpi"><span>MUAMMOLI</span><strong><%= status.red %></strong></article></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">DAVOMAT TAQSIMOTI</span><h2>Kafedra kesimi</h2></div></div><div class="bucket-grid three"><div><b><%= attendanceBuckets.good %></b><span>90–100%</span></div><div><b><%= attendanceBuckets.watch %></b><span>75–89%</span></div><div class="risk"><b><%= attendanceBuckets.problem %></b><span>&lt;75%</span></div></div></article><article class="panel danger-panel"><div class="panel-head"><div><span class="eyebrow">TEZKOR RO‘YXAT</span><h2>Davomati past</h2></div></div><div class="alert-list"><% students.filter(s=>s.attendance<75).slice(0,10).forEach(s=>{ %><a href="/students/<%= s._id %>"><i class="dot red"></i><div><b><%= s.fullName %></b><span><%= s.group||'—' %> · <%= s.attendance %>%</span></div><strong>→</strong></a><% }) %></div></article></section>
