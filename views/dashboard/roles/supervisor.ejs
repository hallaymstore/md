<section class="hero-line role-hero role-hero-supervisor"><div><span class="eyebrow">ILMIY RAHBAR KABINETI</span><h1>Mening magistrantlarim</h1><p>Biriktirilgan magistrantlarning individual reja, dissertatsiya, ilmiy arizalari va muddatlari.</p></div><div class="hero-actions"><a class="secondary" href="/science">Ilmiy faoliyat</a><a class="primary" href="/submissions">Arizalarni ko‘rib chiqish →</a></div></section>
<section class="kpi-grid"><article class="kpi"><span>BIRIKTIRILGAN</span><strong><%= kpis.total %></strong></article><article class="kpi"><span>REJA</span><strong><%= kpis.plan %>%</strong></article><article class="kpi"><span>DISSERTATSIYA</span><strong><%= kpis.dissertation %>%</strong></article><article class="kpi"><span>ILMIY FAOLLIK</span><strong><%= kpis.science %>%</strong></article><article class="kpi"><span>HUJJATLAR</span><strong><%= kpis.documents %>%</strong></article><article class="kpi"><span>MUAMMOLI</span><strong><%= kpis.problemStudents %></strong></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">PORTFEL</span><h2>Magistrantlar bajarilish holati</h2></div></div><div class="student-cards"><% students.forEach(s=>{ %><a href="/students/<%= s._id %>" class="student-progress-card"><%- include('../../partials/avatar', { user:s.user || {role:'student',fullName:s.fullName}, size:'sm' }) %><div class="grow"><b><%= s.fullName %></b><span><%= s.group||'—' %> · <%= s.specialty||'—' %></span><div class="triple-progress"><i style="width:<%= s.individualPlan %>%"></i><i style="width:<%= s.dissertationProgress %>%"></i><i style="width:<%= s.scientificActivity %>%"></i></div></div><strong><%= s.dissertationProgress %>%</strong></a><% }) %></div></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">MUDDATLAR</span><h2>Yaqin topshiriqlar</h2></div><a href="/tasks">Barchasi →</a></div><div class="timeline"><% upcomingTasks.slice(0,8).forEach(t=>{ %><div><time><%= new Date(t.dueDate).toLocaleDateString('uz-UZ') %></time><p><b><%= t.title %></b><span><%= t.student?.fullName||'—' %></span></p></div><% }) %></div></article><article class="panel danger-panel"><div class="panel-head"><div><span class="eyebrow">DIQQAT</span><h2>Ortda qolayotganlar</h2></div></div><div class="alert-list"><% problems.slice(0,8).forEach(s=>{ %><a href="/students/<%= s._id %>"><i class="dot red"></i><div><b><%= s.fullName %></b><span>Reja <%= s.individualPlan %>% · dissertatsiya <%= s.dissertationProgress %>%</span></div><strong>→</strong></a><% }) %></div></article></section>
