<section class="hero-line role-hero role-hero-system"><div><span class="eyebrow">TIZIM BOSHQARUVI</span><h1>Bosh administrator markazi</h1><p>Hisoblar, nazorat, faoliyat tarixi, dars jadvali, hujjatlar va umumiy magistratura holati.</p></div><div class="hero-actions"><a class="secondary" href="/control">Umumiy nazorat</a><a class="secondary" href="/timetable/import">▦ Excel jadval yuklash</a><a class="secondary" href="/audit">Faoliyat tarixi</a><a class="primary" href="/users/new">+ Hisob yaratish</a></div></section>
<section class="kpi-grid wide-kpi">
<article class="kpi" data-card-href="/users"><span>FOYDALANUVCHILAR</span><strong><%= kpis.users %></strong><small>Faol: <b><%= kpis.activeUsers %></b></small></article>
<article class="kpi" data-card-href="/students"><span>MAGISTRANTLAR</span><strong><%= kpis.total %></strong><small>Muammoli: <b><%= kpis.problemStudents %></b></small></article>
<article class="kpi" data-card-href="/timetable"><span>DARS JADVALI</span><strong>▦</strong><small>Excel import va haftalik ko‘rinish</small></article>
<article class="kpi" data-card-href="/audit"><span>BUGUNGI FAOLIYAT</span><strong><%= kpis.auditToday %></strong><small>tizim harakatlari</small></article>
<article class="kpi" data-card-href="/uploads"><span>FAYLLAR</span><strong><%= kpis.uploads %></strong><small>material va hujjatlar</small></article>
<article class="kpi" data-card-href="/analytics"><span>BITIRUV TAYYORLIGI</span><strong><%= kpis.readiness %>%</strong><div class="mini-progress"><i style="width:<%= kpis.readiness %>%"></i></div></article>
</section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">FAKULTETLAR</span><h2>Umumiy holat</h2></div><a href="/analytics">Kengaytirish →</a></div><div class="metric-list"><% facultyStats.slice(0,8).forEach(x=>{ %><div class="metric-row"><div><b><%= x.name %></b><span><%= x.total %> magistrant · <%= x.red %> muammoli</span></div><div class="metric-bars"><em><i style="width:<%= x.attendance %>%"></i></em><strong><%= x.attendance %>%</strong></div></div><% }) %></div></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">TEZKOR BOSHQARUV</span><h2>Administrator amallari</h2></div></div><div class="control-links"><a href="/timetable/import"><b>Excel orqali dars jadvali yuklash</b><small>Shablon → preview → konflikt tekshiruvi → tasdiqlash</small></a><a href="/timetable">Haftalik jadvalni ko‘rish va tahrirlash</a><a href="/users/new">Yangi hisob yaratish</a><a href="/control">Umumiy nazorat markazi</a><a href="/audit">Faoliyat tarixini tekshirish</a></div></article></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">UMUMIY KO‘RSATKICHLAR</span><h2>Monitoring qamrovi</h2></div></div><div class="overview-grid"><div><span>Davomat</span><b><%= kpis.attendance %>%</b></div><div><span>Reja</span><b><%= kpis.plan %>%</b></div><div><span>Dissertatsiya</span><b><%= kpis.dissertation %>%</b></div><div><span>Ilmiy faollik</span><b><%= kpis.science %>%</b></div><div><span>Hujjatlar</span><b><%= kpis.documents %>%</b></div><div><span>O‘zlashtirish</span><b><%= kpis.academic %>%</b></div></div></article><article class="panel"><div class="panel-head"><div><span class="eyebrow">JADVAL IMPORTI</span><h2>Xavfsiz Excel oqimi</h2></div></div><div class="overview-grid"><div><span>1</span><b>Shablon</b></div><div><span>2</span><b>Preview</b></div><div><span>3</span><b>Konflikt</b></div><div><span>4</span><b>Tasdiq</b></div><div><span>5</span><b>Audit</b></div><div><span>6</span><b>Jadval</b></div></div></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">TEZKOR NAZORAT</span><h2>Keskin muammoli magistrantlar</h2></div><span class="badge red"><%= problems.length %> ta</span></div><div class="table-wrap"><table><thead><tr><th>Magistrant</th><th>Fakultet / kafedra</th><th>Davomat</th><th>Reja</th><th>Dissertatsiya</th><th>Hujjatlar</th><th>Qarz</th><th></th></tr></thead><tbody><% problems.slice(0,12).forEach(s=>{ %><tr><td><b><%= s.fullName %></b><small><%= s.group||'—' %></small></td><td><%= s.faculty||'—' %><small><%= s.department||'—' %></small></td><td><%= s.attendance %>%</td><td><%= s.individualPlan %>%</td><td><%= s.dissertationProgress %>%</td><td><%= s.documentsCompleteness %>%</td><td><%= s.academicDebtCount||0 %></td><td><a class="table-link" href="/students/<%= s._id %>">Ochish →</a></td></tr><% }) %></tbody></table></div></section>
