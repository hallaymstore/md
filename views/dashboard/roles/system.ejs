<section class="hero-line role-hero role-hero-system"><div><span class="eyebrow">TIZIM BOSHQARUVI</span><h1>Administrator markazi</h1><p>Hisoblar, monitoring, audit, hujjatlar va universitet bo‘yicha umumiy holat.</p></div><div class="hero-actions"><a class="secondary" href="/control">Global nazorat</a><a class="secondary" href="/audit">Audit</a><a class="primary" href="/submissions">Ilmiy arizalar <%= submissionStats.pending?"("+submissionStats.pending+")":"" %></a></div></section>
<section class="kpi-grid wide-kpi">
<article class="kpi"><span>FOYDALANUVCHILAR</span><strong><%= kpis.users %></strong><small>Faol: <b><%= kpis.activeUsers %></b></small></article>
<article class="kpi"><span>MAGISTRANTLAR</span><strong><%= kpis.total %></strong><small>Muammoli: <b><%= kpis.problemStudents %></b></small></article>
<article class="kpi"><span>BUGUNGI AUDIT</span><strong><%= kpis.auditToday %></strong><small>tizim harakatlari</small></article>
<article class="kpi"><span>FAYLLAR</span><strong><%= kpis.uploads %></strong><small>source va hujjatlar</small></article>
<article class="kpi"><span>OCHIQ TOPSHIRIQ</span><strong><%= kpis.openTasks %></strong><small>kechikkan: <b><%= kpis.overdueTasks %></b></small></article>
<article class="kpi"><span>BITIRUV TAYYORLIGI</span><strong><%= kpis.readiness %>%</strong><div class="mini-progress"><i style="width:<%= kpis.readiness %>%"></i></div></article>
</section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">APPROVAL PIPELINE</span><h2>Ilmiy arizalar tizimi</h2></div><a href="/submissions">Boshqarish →</a></div><div class="overview-grid"><div><span>Jami</span><b><%= submissionStats.total %></b></div><div><span>Jarayonda</span><b><%= submissionStats.inReview %></b></div><div><span>Tuzatishda</span><b><%= submissionStats.needsRevision %></b></div><div><span>Ma’qullangan</span><b><%= submissionStats.approved %></b></div><div><span>Rad etilgan</span><b><%= submissionStats.rejected %></b></div><div><span>Admin kuzatuvidagi navbat</span><b><%= submissionStats.pending %></b></div></div></section>
<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">FAKULTETLAR</span><h2>Universitet kesimidagi holat</h2></div><a href="/analytics">Kengaytirish →</a></div><div class="metric-list"><% facultyStats.slice(0,8).forEach(x=>{ %><div class="metric-row"><div><b><%= x.name %></b><span><%= x.total %> magistrant · <%= x.red %> muammoli</span></div><div class="metric-bars"><em><i style="width:<%= x.attendance %>%"></i></em><strong><%= x.attendance %>%</strong></div></div><% }) %></div></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">SYSTEM HEALTH</span><h2>Monitoring qamrovi</h2></div></div><div class="overview-grid"><div><span>Davomat</span><b><%= kpis.attendance %>%</b></div><div><span>Reja</span><b><%= kpis.plan %>%</b></div><div><span>Dissertatsiya</span><b><%= kpis.dissertation %>%</b></div><div><span>Ilmiy faollik</span><b><%= kpis.science %>%</b></div><div><span>Hujjatlar</span><b><%= kpis.documents %>%</b></div><div><span>O‘zlashtirish</span><b><%= kpis.academic %>%</b></div></div></article></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">TEZKOR NAZORAT</span><h2>Keskin muammoli magistrantlar</h2></div><span class="badge red"><%= problems.length %> ta</span></div><div class="table-wrap"><table><thead><tr><th>Magistrant</th><th>Fakultet / kafedra</th><th>Davomat</th><th>Reja</th><th>Dissertatsiya</th><th>Hujjatlar</th><th>Qarz</th><th></th></tr></thead><tbody><% problems.slice(0,12).forEach(s=>{ %><tr><td><b><%= s.fullName %></b><small><%= s.group||'—' %></small></td><td><%= s.faculty||'—' %><small><%= s.department||'—' %></small></td><td><%= s.attendance %>%</td><td><%= s.individualPlan %>%</td><td><%= s.dissertationProgress %>%</td><td><%= s.documentsCompleteness %>%</td><td><%= s.academicDebtCount||0 %></td><td><a class="table-link" href="/students/<%= s._id %>">Ochish →</a></td></tr><% }) %></tbody></table></div></section>
