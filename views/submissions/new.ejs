<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="hero-line"><div><span class="eyebrow">MAGISTRANT ARIZA MARKAZI</span><h1>Yangi ilmiy ariza</h1><p>Ilmiy ishingizni izoh, manba havolasi va fayllar bilan birga yuboring. Qoralama saqlab keyin davom ettirish ham mumkin.</p></div><a class="secondary" href="/submissions">← Arizalarim</a></section>
<% if(!student){ %><section class="panel empty-state large"><b>Magistrant profili topilmadi</b><span>Hisobingizni magistrant profiliga bog‘lash uchun magistratura bo‘limi yoki administratorga murojaat qiling.</span><a class="secondary" href="/students/me/profile">Profilni tekshirish</a></section><% } else { %>
<section class="grid-3 submission-create-layout"><article class="panel span-2"><div class="panel-head"><div><span class="eyebrow">ARIZA MA’LUMOTLARI</span><h2>Ilmiy materialni taqdim etish</h2></div><span class="badge">Qoralama avtomatik saqlanmaydi</span></div><form method="post" action="/submissions" enctype="multipart/form-data" class="form-grid submission-form"><label>Ariza turi<select name="type" required><% Object.entries(SUBMISSION_TYPES).forEach(([value,label])=>{ %><option value="<%= value %>"><%= label %></option><% }) %></select></label><label>Ustuvorlik<select name="priority"><option value="normal">Oddiy</option><option value="high">Yuqori</option><option value="urgent">Shoshilinch</option></select></label><label class="wide">Ilmiy ish / material nomi<input name="title" minlength="5" maxlength="300" required placeholder="Masalan: Dissertatsiyaning 2-bobi — tajriba natijalari"></label><label class="wide">Qisqacha mazmuni<textarea name="abstract" minlength="20" maxlength="8000" required placeholder="Nima bajarildi, qanday natija olindi va reviewer nimani tekshirishi kerakligini batafsil yozing..."></textarea><small class="field-help">Kamida 20 belgi. Aniq yozilgan mazmun ko‘rib chiqishni tezlashtiradi.</small></label><label class="wide">Kalit so‘zlar<input name="keywords" placeholder="sun’iy intellekt, energetika, optimallashtirish"></label><label>Tashqi manba havolasi<input type="url" name="externalLink" placeholder="https://doi.org/... yoki Google Drive"></label><label>Maqsadli sana<input type="date" name="targetDate"></label><label class="wide">Talaba izohi<textarea name="studentNote" maxlength="4000" placeholder="Ilmiy rahbar va keyingi bosqichdagilar uchun qo‘shimcha tushuntirish..."></textarea></label><label class="dropzone wide" data-file-zone><input type="file" name="files" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.webp,.zip,.ppt,.pptx"><strong>⇧ Fayllarni tanlang</strong><span>5 tagacha · har biri 25 MB · PDF, Word, Excel, rasm, ZIP yoki PPTX</span><small data-file-summary>Hali fayl tanlanmagan</small></label><div class="wide form-actions split"><button class="secondary" name="submitAction" value="draft">Qoralama saqlash</button><button class="primary" name="submitAction" value="submit" <% if(!student.supervisor){ %>disabled title="Ilmiy rahbar biriktirilmagan"<% } %>>Saqlash va rahbarga yuborish →</button></div></form></article>
<aside class="submission-side"><article class="panel identity-card"><div class="avatar large"><%= student.fullName.charAt(0) %></div><div><span class="eyebrow">ARIZA BERUVCHI</span><h2><%= student.fullName %></h2><p><%= student.studentId||'ID yo‘q' %> · <%= student.group||'Guruh yo‘q' %></p></div><dl><div><dt>Fakultet</dt><dd><%= student.faculty||'—' %></dd></div><div><dt>Kafedra</dt><dd><%= student.department||'—' %></dd></div><div><dt>Mutaxassislik</dt><dd><%= student.specialty||'—' %></dd></div><div><dt>Ilmiy rahbar</dt><dd><%= student.supervisor?.fullName||'Biriktirilmagan' %></dd></div></dl><% if(!student.supervisor){ %><div class="inline-alert danger"><b>Ilmiy rahbar yo‘q</b><span>Qoralama saqlanadi, lekin rahbar biriktirilmaguncha yuborilmaydi.</span></div><% } %></article><article class="panel compact-rules"><span class="eyebrow">MUHIM</span><h2>Yuborishdan oldin</h2><ol><li>Faylning oxirgi variantini tanlang.</li><li>Mavzu va mazmunni aniq yozing.</li><li>Rad/tuzatish qarorida sharhni o‘qing.</li><li>Tuzatilgan fayl yangi versiyada saqlanadi.</li></ol></article></aside></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">KEYINGI JARAYON</span><h2>Arizangizning tasdiqlash xaritasi</h2></div></div><div class="workflow-strip spacious"><div class="workflow-person student"><i>✓</i><b>Siz</b><span>Ariza yuborasiz</span></div><% WORKFLOW_STAGES.forEach(stage=>{ %><div class="workflow-arrow">→</div><div class="workflow-person"><i>○</i><b><%= STAGE_LABELS[stage] %></b><span>Qaror + sharh</span></div><% }) %></div></section><% } %>
</main></div><%- include('../partials/foot') %>
