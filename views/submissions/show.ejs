<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="hero-line submission-detail-hero"><div><div class="hero-meta"><span class="application-no"><%= submission.applicationNo %></span><span class="status <%= STATUS_TONES[submission.status]||'muted' %>"><%= STATUS_LABELS[submission.status]||submission.status %></span><span class="chip">Versiya <%= submission.revision %></span><% if(submission.priority!=='normal'){ %><span class="priority <%= submission.priority==='urgent'?'critical':'high' %>"><%= submission.priority==='urgent'?'SHOSHILINCH':'YUQORI' %></span><% } %></div><h1><%= submission.title %></h1><p><%= SUBMISSION_TYPES[submission.type]||submission.type %> · <%= submission.student?.fullName||'—' %> · <%= submission.department %></p></div><div class="hero-actions"><a class="secondary" href="/submissions">← Ro‘yxat</a><% if(permissions.canSubmit){ %><form method="post" action="/submissions/<%= submission._id %>/submit"><input type="hidden" name="recordVersion" value="<%= submission.__v %>"><button class="primary" data-confirm="Arizani hozirgi ma’lumotlar bilan ko‘rib chiqishga yuborasizmi?">Rahbarga yuborish →</button></form><% } %></div></section>

<section class="panel workflow-detail"><div class="panel-head"><div><span class="eyebrow">JARAYON HOLATI</span><h2><%= submission.status==='approved'?'Barcha bosqichlar muvaffaqiyatli yakunlangan':submission.status==='changes_requested'?`${STAGE_LABELS[submission.resumeStage]} tuzatish kutmoqda`:`Joriy navbat: ${STAGE_LABELS[submission.currentStage]||submission.currentStage}` %></h2></div><small>Oxirgi amal: <%= new Date(submission.lastActionAt||submission.updatedAt).toLocaleString('uz-UZ') %></small></div><div class="workflow-steps"><div class="workflow-step done"><span>✓</span><div><b>Magistrant</b><small>Ariza yaratildi</small></div></div><% WORKFLOW_STAGES.forEach(stage=>{ const row=submission.stageProgress.find(x=>x.stage===stage)||{status:'waiting'}; const icon=row.status==='approved'?'✓':row.status==='rejected'?'×':row.status==='changes_requested'?'↩':row.status==='pending'?'…':'○'; %><div class="workflow-step <%= row.status %> <%= submission.currentStage===stage?'current':'' %>"><span><%= icon %></span><div><b><%= STAGE_LABELS[stage] %></b><small><%= row.status==='approved'?'Ma’qullangan':row.status==='pending'?'Ko‘rib chiqmoqda':row.status==='changes_requested'?'Tuzatishga qaytargan':row.status==='rejected'?'Rad etgan':'Navbat kutmoqda' %></small><% if(row.actedBy){ %><em><%= row.actedBy.fullName %></em><% } %></div></div><% }) %></div></section>

<section class="grid-3 submission-detail-grid"><div class="span-2 detail-main"><article class="panel"><div class="panel-head"><div><span class="eyebrow">ARIZA MAZMUNI</span><h2>Qisqacha tavsif</h2></div></div><p class="submission-abstract"><%= submission.abstract %></p><% if(submission.keywords?.length){ %><div class="tag-row"><% submission.keywords.forEach(keyword=>{ %><span><%= keyword %></span><% }) %></div><% } %><% if(submission.studentNote){ %><div class="note-box"><b>Magistrant izohi</b><p><%= submission.studentNote %></p></div><% } %><% if(submission.externalLink){ %><a class="external-source" href="<%= submission.externalLink %>" target="_blank" rel="noopener noreferrer"><i>↗</i><div><b>Tashqi manbani ochish</b><span><%= submission.externalLink %></span></div></a><% } %></article>

<article class="panel"><div class="panel-head"><div><span class="eyebrow">HIMOYALANGAN FAYLLAR</span><h2>Biriktirmalar · <%= submission.attachments.length %> ta</h2></div><span class="secure-tag">Faqat vakolat bilan</span></div><div class="attachment-list"><% submission.attachments.forEach(file=>{ %><div class="attachment-row"><a href="/submissions/<%= submission._id %>/files/<%= file._id %>"><i>⌑</i><div><b><%= file.originalName %></b><span><%= (file.size/1024/1024).toFixed(2) %> MB · v<%= file.submissionRevision||1 %> · <%= new Date(file.createdAt).toLocaleString('uz-UZ') %></span><small><%= file.uploadedBy?.fullName||'—' %></small></div><strong>Yuklash ↓</strong></a><% if(permissions.canEdit){ %><form method="post" action="/submissions/<%= submission._id %>/files/<%= file._id %>/delete"><button class="danger-btn" data-confirm="Bu faylni arizadan olib tashlaysizmi?">Olib tashlash</button></form><% } %></div><% }) %><% if(!submission.attachments.length){ %><div class="empty">Fayl biriktirilmagan. Tashqi havola bo‘lsa, yuqorida ko‘rsatiladi.</div><% } %></div></article>

<% if(permissions.canEdit){ %><details class="panel edit-submission" <%= submission.status==='changes_requested'?'open':'' %>><summary><div><span class="eyebrow"><%= submission.status==='changes_requested'?'TUZATISH TALAB QILINDI':'QORALAMANI TAHRIRLASH' %></span><h2>Ariza va yangi versiya fayllarini yangilash</h2></div><strong>Ochish / yopish</strong></summary><form method="post" action="/submissions/<%= submission._id %>/save" enctype="multipart/form-data" class="form-grid submission-form"><input type="hidden" name="recordVersion" value="<%= submission.__v %>"><label>Ariza turi<select name="type"><% Object.entries(SUBMISSION_TYPES).forEach(([value,label])=>{ %><option value="<%= value %>" <%= submission.type===value?'selected':'' %>><%= label %></option><% }) %></select></label><label>Ustuvorlik<select name="priority"><option value="normal" <%= submission.priority==='normal'?'selected':'' %>>Oddiy</option><option value="high" <%= submission.priority==='high'?'selected':'' %>>Yuqori</option><option value="urgent" <%= submission.priority==='urgent'?'selected':'' %>>Shoshilinch</option></select></label><label class="wide">Nomi<input name="title" minlength="5" maxlength="300" value="<%= submission.title %>" required></label><label class="wide">Qisqacha mazmun<textarea name="abstract" minlength="20" maxlength="8000" required><%= submission.abstract %></textarea></label><label class="wide">Kalit so‘zlar<input name="keywords" value="<%= submission.keywords.join(', ') %>"></label><label>Tashqi havola<input type="url" name="externalLink" value="<%= submission.externalLink||'' %>"></label><label>Maqsadli sana<input type="date" name="targetDate" value="<%= submission.targetDate?new Date(submission.targetDate).toISOString().slice(0,10):'' %>"></label><label class="wide">Talaba izohi<textarea name="studentNote"><%= submission.studentNote||'' %></textarea></label><label class="dropzone wide" data-file-zone><input type="file" name="files" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.webp,.zip,.ppt,.pptx"><strong>⇧ Tuzatilgan / qo‘shimcha fayllarni tanlang</strong><span>Oldingi fayllar saqlanib qoladi; kerakmasini alohida olib tashlang.</span><small data-file-summary>Hali yangi fayl tanlanmagan</small></label><div class="wide form-actions split"><button class="secondary" name="submitAction" value="draft">Faqat saqlash</button><button class="primary" name="submitAction" value="submit">Saqlash va qayta yuborish →</button></div></form></details><% } %>

<% if(permissions.canReview){ %><article class="panel decision-panel"><div class="panel-head"><div><span class="eyebrow">SIZNING QARORINGIZ</span><h2><%= STAGE_LABELS[submission.currentStage] %> bosqichi</h2></div><span class="badge yellow">Qaror kutilmoqda</span></div><form method="post" action="/submissions/<%= submission._id %>/decision" class="decision-form"><input type="hidden" name="recordVersion" value="<%= submission.__v %>"><label>Talabaga va keyingi bosqichga sharh<textarea name="comment" minlength="3" maxlength="4000" required placeholder="Tekshirilgan jihatlar, tavsiya yoki qaror sababini aniq yozing..."></textarea></label><div class="decision-actions"><button class="approve-btn" name="decision" value="approve" data-confirm="Arizani ma’qullab keyingi bosqichga yuborasizmi?">✓ Ma’qullash</button><button class="changes-btn" name="decision" value="changes" data-confirm="Arizani sharh bilan talabaga tuzatishga qaytarasizmi?">↩ Tuzatishga qaytarish</button><button class="reject-btn" name="decision" value="reject" data-confirm="Arizani rad etasizmi? Bu qaror jarayonni to‘xtatadi.">× Rad etish</button></div></form></article><% } %>

<article class="panel history-panel"><div class="panel-head"><div><span class="eyebrow">O‘ZGARMAS JARAYON TARIXI</span><h2>Qarorlar va sharhlar</h2></div><span class="badge"><%= submission.history.length %> yozuv</span></div><div class="history-timeline"><% [...submission.history].reverse().forEach(item=>{ %><div class="history-item action-<%= item.action %>"><i></i><div class="history-card"><div><b><%= ACTION_LABELS[item.action]||item.action %></b><time><%= new Date(item.createdAt).toLocaleString('uz-UZ') %></time></div><span><%= item.actor?.fullName||'Tizim' %> · <%= item.actorRole?STAGE_LABELS[item.actorRole]||roleLabels[item.actorRole]||item.actorRole:'—' %> · v<%= item.revision %></span><% if(item.fromStage||item.toStage){ %><small><%= STAGE_LABELS[item.fromStage]||item.fromStage||'Boshlanish' %> → <%= STAGE_LABELS[item.toStage]||item.toStage||'—' %></small><% } %><% if(item.comment){ %><p><%= item.comment %></p><% } %></div></div><% }) %></div></article>

<% if(permissions.canComment){ %><article class="panel"><div class="panel-head"><div><span class="eyebrow">ALOQA</span><h2>Qo‘shimcha sharh yozish</h2></div></div><form method="post" action="/submissions/<%= submission._id %>/comment" class="comment-form"><textarea name="comment" minlength="2" maxlength="4000" required placeholder="Savol, javob yoki qo‘shimcha tushuntirish..."></textarea><button class="primary">Sharh yuborish</button></form></article><% } %></div>

<aside class="submission-side"><article class="panel identity-card"><div class="avatar large"><%= submission.student?.fullName?.charAt(0)||'M' %></div><div><span class="eyebrow">MAGISTRANT</span><h2><%= submission.student?.fullName||'—' %></h2><p><%= submission.student?.studentId||'ID yo‘q' %> · <%= submission.group||'—' %></p></div><dl><div><dt>Fakultet</dt><dd><%= submission.faculty %></dd></div><div><dt>Kafedra</dt><dd><%= submission.department %></dd></div><div><dt>Mutaxassislik</dt><dd><%= submission.specialty||'—' %></dd></div><div><dt>Ilmiy rahbar</dt><dd><%= submission.supervisor?.fullName||'Biriktirilmagan' %></dd></div><div><dt>Yaratilgan</dt><dd><%= new Date(submission.createdAt).toLocaleString('uz-UZ') %></dd></div><div><dt>Maqsadli sana</dt><dd><%= submission.targetDate?new Date(submission.targetDate).toLocaleDateString('uz-UZ'):'Belgilanmagan' %></dd></div></dl></article>
<% if(permissions.canWithdraw){ %><article class="panel danger-panel"><span class="eyebrow">TALABA AMALI</span><h2>Ko‘rib chiqishdan qaytarish</h2><p class="muted">Ariza xato yuborilgan bo‘lsa, navbatdan oling. Keyin uni faqat administrator qayta ochadi.</p><form method="post" action="/submissions/<%= submission._id %>/withdraw"><textarea name="comment" placeholder="Sabab (ixtiyoriy)"></textarea><button class="danger-btn solid full" data-confirm="Arizani ko‘rib chiqishdan qaytarib olasizmi?">Arizani qaytarib olish</button></form></article><% } %>
<% if(permissions.canAdmin){ %><article class="panel admin-workflow"><span class="eyebrow">JARAYONNI BOSHQARISH</span><h2>Jarayonni boshqarish</h2><p>Har bir muhim amal sabab bilan faoliyat tarixida qayd etiladi.</p><form method="post" action="/submissions/<%= submission._id %>/admin"><label>Amal<select name="adminAction" data-admin-action><option value="reopen">Talabaga qayta ochish</option><option value="reroute">Bosqichga yo‘naltirish</option><option value="reassign_supervisor">Ilmiy rahbarni almashtirish</option><option value="archive">Arxivlash</option></select></label><label data-admin-stage>Bosqich<select name="stage"><% WORKFLOW_STAGES.forEach(stage=>{ %><option value="<%= stage %>"><%= STAGE_LABELS[stage] %></option><% }) %></select></label><label data-admin-supervisor>Yangi rahbar<select name="supervisor"><option value="">Tanlang</option><% supervisors.forEach(user=>{ %><option value="<%= user._id %>"><%= user.fullName %> · <%= user.department||'—' %></option><% }) %></select></label><label class="check-line" data-admin-supervisor><input type="checkbox" name="updateStudent"><span>Talaba profilida ham almashtirish</span></label><label>Majburiy sabab<textarea name="comment" minlength="3" maxlength="4000" required></textarea></label><button class="secondary full" data-confirm="Ushbu boshqaruv amalini bajarishni tasdiqlaysizmi?">Amalni bajarish</button></form></article><% } %></aside></section>
</main></div><%- include('../partials/foot') %>
