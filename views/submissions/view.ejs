<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content"><%- include('../partials/flash') %>
<section class="hero-line"><div><span class="eyebrow"><%= typeLabels[item.type]||item.type %> • REVISION <%= item.revision %></span><h1><%= item.title %></h1><p><%= item.student?.fullName||'—' %> · <%= item.group||'—' %> · <%= item.department||'—' %></p></div><div class="hero-actions"><a class="secondary" href="/submissions">← Ro‘yxat</a><span class="status big <%= item.status==='approved'?'green':item.status==='rejected'?'red':item.status==='needs_revision'?'yellow':'' %>"><%= statusLabels[item.status]||item.status %></span></div></section>

<section class="workflow-track panel"><% flow.forEach((stage,i)=>{ const hist=item.history||[]; const passed=hist.some(h=>h.action==='approved'&&h.stage===stage); const current=item.currentStage===stage; %><div class="workflow-node <%= passed?'done':'' %> <%= current?'active':'' %>"><i><%= passed?'✓':i+1 %></i><span><%= stageLabels[stage] %></span><small><%= current?'Joriy bosqich':passed?'Ma’qullangan':'Kutilmoqda' %></small></div><% if(i<flow.length-1){ %><b>→</b><% } %><% }) %><b>→</b><div class="workflow-node <%= item.status==='approved'?'done':'' %>"><i><%= item.status==='approved'?'✓':'★' %></i><span>Yakun</span><small><%= item.status==='approved'?'Tasdiqlandi':'Kutilmoqda' %></small></div></section>

<section class="grid-3 submission-detail-grid"><article class="panel span-2"><div class="panel-head"><div><span class="eyebrow">ARIZA MAZMUNI</span><h2>Material haqida</h2></div></div><dl class="detail-list"><div><dt>Tur</dt><dd><%= typeLabels[item.type]||item.type %></dd></div><div><dt>Tashkilot / jurnal</dt><dd><%= item.organization||'—' %></dd></div><div><dt>Sana</dt><dd><%= item.eventDate?new Date(item.eventDate).toLocaleDateString('uz-UZ'):'—' %></dd></div><div><dt>Kalit so‘zlar</dt><dd><%= item.keywords||'—' %></dd></div><div class="wide"><dt>Mazmun</dt><dd><%= item.description %></dd></div><div class="wide"><dt>Havola</dt><dd><% if(item.link){ %><a class="table-link" target="_blank" href="<%= item.link %>"><%= item.link %></a><% } else { %>—<% } %></dd></div></dl></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">MAGISTRANT</span><h2><%= item.student?.fullName||'—' %></h2></div></div><div class="profile-facts"><p><span>ID</span><b><%= item.student?.studentId||'—' %></b></p><p><span>Fakultet</span><b><%= item.faculty||'—' %></b></p><p><span>Kafedra</span><b><%= item.department||'—' %></b></p><p><span>Guruh</span><b><%= item.group||'—' %></b></p><p><span>Ilmiy rahbar</span><b><%= item.supervisor?.fullName||'—' %></b></p></div></article></section>

<section class="grid-2"><article class="panel"><div class="panel-head"><div><span class="eyebrow">SOURCE / ATTACHMENTS</span><h2>Biriktirilgan fayllar</h2></div><span class="badge"><%= item.attachments?.length||0 %></span></div><div class="file-grid compact-files"><% (item.attachments||[]).forEach(f=>{ %><a class="file-card" href="<%= f.path %>" target="_blank"><div class="file-icon">⌑</div><div><b><%= f.originalName %></b><span><%= (Number(f.size||0)/1024/1024).toFixed(2) %> MB</span><small><%= new Date(f.createdAt).toLocaleString('uz-UZ') %></small></div></a><% }) %></div></article>
<article class="panel"><div class="panel-head"><div><span class="eyebrow">JORIY HOLAT</span><h2><%= stageLabels[item.currentStage]||item.currentStage %></h2></div></div><div class="overview-grid compact"><div><span>Revision</span><b><%= item.revision %></b></div><div><span>Holat</span><b class="small-value"><%= statusLabels[item.status]||item.status %></b></div><div><span>Yuborilgan</span><b class="small-value"><%= new Date(item.submittedAt).toLocaleDateString('uz-UZ') %></b></div><div><span>Yangilangan</span><b class="small-value"><%= new Date(item.updatedAt).toLocaleDateString('uz-UZ') %></b></div></div></article></section>

<% if(canReviewCurrent){ %><section class="panel review-decision-panel"><div class="panel-head"><div><span class="eyebrow">SIZNING NAVBATINGIZ</span><h2>Qaror va sharh</h2><p>Sharhsiz qaror qabul qilinmaydi. Sharh magistrant va keyingi tasdiqlovchilarga ko‘rinadi.</p></div></div><form method="post" action="/submissions/<%= item._id %>/decision" class="review-form"><label class="wide">Sharh *<textarea name="comment" required placeholder="Ilmiy mazmun, kamchiliklar, tuzatishlar yoki ma’qullash sababi..."></textarea></label><div class="decision-buttons"><button class="decision approve" name="decision" value="approve">✓ Ma’qullash va keyingiga yuborish</button><button class="decision revise" name="decision" value="revision">↶ Talabaga qaytarish</button><button class="decision reject" name="decision" value="reject" onclick="return confirm('Arizani yakuniy rad etasizmi?')">× Rad etish</button></div></form></section><% } %>

<% if(currentUser.role==='student' && item.status==='needs_revision' && item.currentStage==='student'){ %><section class="panel revision-panel"><div class="panel-head"><div><span class="eyebrow">QAYTA ISHLASH</span><h2>Tuzatishlarni kiriting va qayta yuboring</h2><p>Yangi fayl qo‘shsangiz eski versiyalar ham tarix uchun saqlanadi.</p></div></div><form method="post" action="/submissions/<%= item._id %>/resubmit" enctype="multipart/form-data" class="form-grid"><label class="wide">Nomi<input name="title" value="<%= item.title %>"></label><label class="wide">Yangilangan mazmun<textarea name="description"><%= item.description %></textarea></label><label>Tashkilot<input name="organization" value="<%= item.organization||'' %>"></label><label>Kalit so‘zlar<input name="keywords" value="<%= item.keywords||'' %>"></label><label class="wide">Havola<input name="link" value="<%= item.link||'' %>"></label><label class="dropzone wide"><input type="file" name="files" multiple><strong>⇧ Yangi versiya fayllari</strong><span>Ixtiyoriy · 5 tagacha</span></label><label class="wide">Tuzatish izohi *<textarea name="comment" required placeholder="Qaysi tavsiyalar bajarildi..."></textarea></label><div class="wide form-actions"><button class="primary xl">Qayta yuborish → <%= stageLabels[item.returnStage] %></button></div></form></section><% } %>

<section class="panel"><div class="panel-head"><div><span class="eyebrow">AUDIT TRAIL</span><h2>Sharhlar va qarorlar tarixi</h2></div><span class="badge"><%= item.history?.length||0 %> yozuv</span></div><div class="approval-timeline"><% [...(item.history||[])].reverse().forEach(h=>{ %><div class="approval-event <%= h.action %>"><div class="event-dot"><%= h.action==='approved'?'✓':h.action==='rejected'?'×':h.action==='revision'?'↶':h.action==='resubmitted'?'↗':'•' %></div><div class="event-body"><div><b><%= h.actor?.fullName||roleLabels[h.actorRole]||h.actorRole %></b><span class="chip"><%= stageLabels[h.stage]||h.stage %></span><span class="chip soft"><%= h.action %></span></div><p><%= h.comment||'—' %></p><small>Revision <%= h.revision %> · <%= new Date(h.createdAt).toLocaleString('uz-UZ') %><% if(h.fromStage&&h.toStage&&h.fromStage!==h.toStage){ %> · <%= stageLabels[h.fromStage]||h.fromStage %> → <%= stageLabels[h.toStage]||h.toStage %><% } %></small></div></div><% }) %></div></section>

<% if(canCommentCurrent && item.status!=='rejected'){ %><section class="panel"><div class="panel-head"><div><span class="eyebrow">SHARH</span><h2>Qarorsiz izoh qoldirish</h2></div></div><form method="post" action="/submissions/<%= item._id %>/comment" class="inline-comment"><textarea name="comment" required placeholder="Savol, aniqlik yoki qisqa tavsiya..."></textarea><button class="secondary">Sharh qo‘shish</button></form></section><% } %>

<% if(currentUser.role==='superadmin'){ %><section class="panel admin-maintenance"><div class="panel-head"><div><span class="eyebrow">BOSH ADMIN</span><h2>Ariza ma’lumotlarini boshqarish</h2></div></div><form method="post" action="/submissions/<%= item._id %>/admin-edit" class="form-grid"><label>Tur<select name="type"><% Object.entries(typeLabels).forEach(([v,l])=>{ %><option value="<%= v %>" <%= item.type===v?'selected':'' %>><%= l %></option><% }) %></select></label><label>Tashkilot<input name="organization" value="<%= item.organization||'' %>"></label><label class="wide">Nomi<input name="title" value="<%= item.title %>"></label><label class="wide">Mazmun<textarea name="description"><%= item.description %></textarea></label><label class="wide">Havola<input name="link" value="<%= item.link||'' %>"></label><label class="wide">Admin izohi<input name="comment" placeholder="Nega tahrir qilindi..."></label><div class="wide form-actions"><button class="secondary">Metama’lumotni saqlash</button></div></form><form method="post" action="/submissions/<%= item._id %>/delete" onsubmit="return confirm('Ariza va uning source fayllari butunlay o‘chirilsinmi?')"><button class="decision reject">Arizani butunlay o‘chirish</button></form></section><% } %>
</main></div><%- include('../partials/foot') %>
