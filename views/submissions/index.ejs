<%- include('../partials/head') %><%- include('../partials/sidebar') %>
<div class="app"><%- include('../partials/topbar') %><main class="content">
<%- include('../partials/flash') %>
<section class="hero-line role-hero submission-hero"><div><span class="eyebrow">ILMIY ARIZALARNI TASDIQLASH</span><h1><%= currentUser.role==='student'?'Ilmiy arizalarim':'Ilmiy arizalar navbati' %></h1><p><%= currentUser.role==='student'?'Ilmiy ish, dissertatsiya bobi, maqola va tegishli fayllarni ariza shaklida yuboring. Har bir qaror va izoh shu yerda saqlanadi.':'Ilmiy rahbar, kafedra, dekanat, magistratura va rahbariyat tasdiqlarini yagona navbatda boshqaring.' %></p></div><div class="hero-actions"><a class="secondary" href="/submissions/export.csv">Jadvalni yuklab olish</a><% if(currentUser.role==='student'){ %><a class="primary" href="/submissions/new">+ Yangi ariza</a><% } %></div></section>

<% const queueLabel=currentUser.role==='student'?'TUZATISH KUTILMOQDA':currentUser.role==='tech'?'JARAYONDAGI':currentUser.role==='superadmin'?'NAZORATDAGI':'MENING NAVBATIM'; %><section class="kpi-grid submission-kpis"><article class="kpi"><span>JAMI</span><strong><%= stats.total %></strong></article><article class="kpi focus"><span><%= queueLabel %></span><strong><%= stats.pending %></strong></article><article class="kpi"><span>JARAYONDA</span><strong><%= stats.reviewing %></strong></article><article class="kpi"><span>TASDIQLANGAN</span><strong><%= stats.approved %></strong></article><article class="kpi"><span>TUZATISHDA</span><strong><%= stats.changes %></strong></article><article class="kpi"><span>RAD ETILGAN</span><strong><%= stats.rejected %></strong></article><article class="kpi"><span>MUDDATI O‘TGAN</span><strong><%= stats.overdue %></strong></article></section>

<section class="panel workflow-guide"><div class="panel-head"><div><span class="eyebrow">TASDIQLASH YO‘LI</span><h2>Ariza qaysi tartibda o‘tadi?</h2></div></div><div class="workflow-strip"><div class="workflow-person"><i>1</i><b>Magistrant</b><span>Yuboradi</span></div><% WORKFLOW_STAGES.forEach((stage,index)=>{ %><div class="workflow-arrow">→</div><div class="workflow-person"><i><%= index+2 %></i><b><%= STAGE_LABELS[stage] %></b><span>Ma’qul / tuzatish / rad</span></div><% }) %></div></section>

<section class="panel filter-panel"><form method="get" action="/submissions" class="submission-filters"><label>Qidiruv<input name="q" value="<%= filters.q %>" placeholder="Ariza №, mavzu, magistrant..."></label><label>Holat<select name="status"><option value="">Barcha holatlar</option><% Object.entries(STATUS_LABELS).forEach(([value,label])=>{ %><option value="<%= value %>" <%= filters.status===value?'selected':'' %>><%= label %></option><% }) %></select></label><label>Bosqich<select name="stage"><option value="">Barcha bosqichlar</option><option value="student" <%= filters.stage==='student'?'selected':'' %>>Magistrantda</option><% WORKFLOW_STAGES.forEach(stage=>{ %><option value="<%= stage %>" <%= filters.stage===stage?'selected':'' %>><%= STAGE_LABELS[stage] %></option><% }) %><option value="completed" <%= filters.stage==='completed'?'selected':'' %>>Yakunlangan</option></select></label><label>Ariza turi<select name="type"><option value="">Barcha turlar</option><% Object.entries(SUBMISSION_TYPES).forEach(([value,label])=>{ %><option value="<%= value %>" <%= filters.type===value?'selected':'' %>><%= label %></option><% }) %></select></label><button class="primary">Saralash</button><a class="ghost filter-reset" href="/submissions">Tozalash</a></form></section>

<section class="submission-list"><% submissions.forEach(item=>{ const tone=STATUS_TONES[item.status]||'muted'; const current=item.stageProgress?.find(x=>x.stage===item.currentStage); %><a class="submission-card panel <%= item.priority==='urgent'?'urgent-card':'' %>" href="/submissions/<%= item._id %>"><div class="submission-card-head"><div><span class="application-no"><%= item.applicationNo %></span><span class="status <%= tone %>"><%= STATUS_LABELS[item.status]||item.status %></span><% if(item.priority!=='normal'){ %><span class="priority <%= item.priority==='urgent'?'critical':'high' %>"><%= item.priority==='urgent'?'SHOSHILINCH':'YUQORI' %></span><% } %></div><time><%= new Date(item.lastActionAt||item.updatedAt).toLocaleString('uz-UZ') %></time></div><div class="submission-card-body"><div class="grow"><span class="eyebrow"><%= SUBMISSION_TYPES[item.type]||item.type %></span><h2><%= item.title %></h2><p><b><%= item.student?.fullName||'—' %></b> · <%= item.student?.group||item.group||'—' %> · <%= item.department||'—' %></p></div><div class="current-stage"><span>Joriy bosqich</span><b><%= STAGE_LABELS[item.currentStage]||item.currentStage %></b><small><%= current?.actedBy?.fullName || (item.currentStage==='supervisor'?item.supervisor?.fullName:'') || 'Navbatda' %></small></div></div><div class="mini-workflow"><% WORKFLOW_STAGES.forEach(stage=>{ const step=item.stageProgress?.find(x=>x.stage===stage); %><i class="<%= step?.status||'waiting' %> <%= item.currentStage===stage?'active':'' %>" title="<%= STAGE_LABELS[stage] %>"></i><% }) %></div><div class="submission-card-foot"><span>Tahrir <b><%= item.revision %></b></span><span>Fayllar <b><%= item.attachments?.length||0 %></b></span><span>Muddat <b><%= item.targetDate?new Date(item.targetDate).toLocaleDateString('uz-UZ'):'Belgilanmagan' %></b></span><strong>Ochish →</strong></div></a><% }) %><% if(!submissions.length){ %><div class="panel empty-state large"><b>Ariza topilmadi</b><span><%= currentUser.role==='student'?'Birinchi ilmiy arizangizni yarating yoki filtrlarni tozalang.':'Hozir tanlangan shartlarga mos ariza yo‘q.' %></span><% if(currentUser.role==='student'){ %><a class="primary" href="/submissions/new">Yangi ariza yaratish</a><% } %></div><% } %></section>

<% if(pagination.pages>1){ const qs=`&status=${encodeURIComponent(filters.status)}&stage=${encodeURIComponent(filters.stage)}&type=${encodeURIComponent(filters.type)}&q=${encodeURIComponent(filters.q)}`; %><nav class="pagination"><% if(pagination.page>1){ %><a href="?page=<%= pagination.page-1 %><%= qs %>">← Oldingi</a><% } %><span><b><%= pagination.page %></b> / <%= pagination.pages %> · <%= pagination.total %> ta</span><% if(pagination.page<pagination.pages){ %><a href="?page=<%= pagination.page+1 %><%= qs %>">Keyingi →</a><% } %></nav><% } %>
</main></div><%- include('../partials/foot') %>
