NODE_ENV=development
PORT=3001
# MongoDB Atlas yoki lokal MongoDB. Bittasi yetarli; MONGODB_URI tavsiya qilinadi.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/md?retryWrites=true&w=majority
# MONGO_URI=...
SESSION_SECRET=replace-with-a-long-random-secret
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=Admin123!
UPLOAD_LIMIT_MB=20
SUBMISSION_FILE_LIMIT_MB=25
SUBMISSION_MAX_FILES=5

# Katta ekran sozlamalari
DISPLAY_TITLE=MD
DISPLAY_SUBTITLE=Magistratura boshqaruvi — jonli monitoring
DISPLAY_REFRESH_MS=5000
